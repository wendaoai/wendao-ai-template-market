{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitcode.com/wendao-ai/wendao-ai-template-market/schemas/detached-signature-v1.schema.json",
  "title": "Detached Ed25519 Signature v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "keyId", "signedFile", "sha256", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "ed25519" },
    "keyId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "signedFile": { "const": "stable.json" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": { "type": "string", "minLength": 80, "maxLength": 120 }
  }
}

