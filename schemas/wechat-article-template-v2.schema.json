{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitcode.com/wendao-ai/wendao-ai-template-market/schemas/wechat-article-template-v2.schema.json",
  "title": "Wechat Article Template Source v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "releasedAt",
    "changeSummary",
    "status",
    "replacementId",
    "name",
    "description",
    "source",
    "category",
    "tags",
    "selectable",
    "recommended",
    "riskLevel",
    "editorMode",
    "css"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "releasedAt": { "type": "string", "format": "date-time" },
    "changeSummary": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["active", "deprecated"] },
    "replacementId": { "type": "string", "maxLength": 80 },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "description": { "type": "string", "minLength": 1, "maxLength": 160 },
    "source": { "enum": ["wemd", "md", "neurapress", "cw"] },
    "category": { "enum": ["recommended", "knowledge", "opinion", "tech", "lifestyle", "visual", "code"] },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 16 }
    },
    "selectable": { "type": "boolean" },
    "recommended": { "type": "boolean" },
    "riskLevel": { "enum": ["stable", "experimental"] },
    "editorMode": { "enum": ["visual", "css"] },
    "css": { "type": "string", "minLength": 1, "maxLength": 262144 },
    "designerVariables": { "type": "object", "minProperties": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "deprecated" } }, "required": ["status"] },
      "then": { "properties": { "selectable": { "const": false } } }
    },
    {
      "if": { "properties": { "editorMode": { "const": "visual" } }, "required": ["editorMode"] },
      "then": { "required": ["designerVariables"] }
    },
    {
      "if": { "properties": { "editorMode": { "const": "css" } }, "required": ["editorMode"] },
      "then": { "not": { "required": ["designerVariables"] } }
    }
  ]
}
