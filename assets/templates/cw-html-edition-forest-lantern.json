:\"0 0 18px\"},\"heading\":{\"display\":\"block\",\"width\":\"auto\",\"color\":\"#d1c780\",\"background\":\"transparent\",\"border\":\"0\",\"padding\":\"0 0 14px\",\"margin\":\"0 0 16px\",\"line-height\":\"1.5\",\"font-size\":\"24px\",\"font-weight\":\"400\"},\"quote\":{\"margin\":\"24px 0\",\"line-height\":\"1.9\",\"color\":\"#e7ead8\",\"font-size\":\"21px\",\"text-align\":\"center\",\"border\":\"0\",\"border-radius\":\"30px 0 30px 0\",\"padding\":\"24px 20px\",\"background-color\":\"#2b493c\"},\"ending\":{\"font-size\":\"16px\",\"color\":\"#e7ead8\",\"line-height\":\"1.95\",\"margin\":\"32px 0 0\",\"border\":\"0\",\"border-top\":\"1px solid #b1c1a6\",\"padding\":\"18px 0 0\"},\"image\":{\"margin\":\"24px 0\"},\"table\":{\"font-size\":\"15px\",\"line-height\":\"1.7\"}},\"chapters\":[{\"width\":\"100%\",\"margin\":\"36px 0 0\",\"padding\":\"18px 0 0\",\"border\":\"0\",\"background\":\"transparent\"}],\"headingSurface\":{},\"bodySurface\":{},\"initial\":{}},\"blocks\":[]}]",
