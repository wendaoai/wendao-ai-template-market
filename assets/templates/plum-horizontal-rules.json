{
  "schemaVersion": 1,
  "id": "aiwritex-html-b1d2768c927f",
  "type": "html-template",
  "original": {
    "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n\n<body>\n  <section\n    style=\"max-width:100%; margin:0 auto; font-family:'PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif; color:#333; line-height:1.6; padding:0; background:linear-gradient(135deg, #f9f9f9, #ffffff);\">\n\n    <section\n      style=\"padding:25px 10px; background:linear-gradient(135deg, #3a1c71, #d76d77); color:white; border-radius:0 0 25px 25px; overflow:hidden; box-shadow:0 4px 15px rgba(0,0,0,0.2); display: flex; align-items: flex-start;\">\n      <section style=\"display: inline-block; vertical-align: top;\">\n        <h1\n          style=\"font-size:24px; font-weight:700; margin:0; letter-spacing:1px; text-shadow:1px 1px 3px rgba(0,0,0,0.3);\">\n          楼市政策大转向</h1>\n        <p style=\"font-size:16px; margin:8px 0 15px; font-weight:300; opacity:0.9;\">住建部剑指楼市下行，30万亿市场规则或将改写</p>\n      </section>\n      <section style=\"margin-left: auto; margin-right: 10px;\">\n        <svg width=\"80\" height=\"80\" viewBox=\"0 0 100 100\" style=\"opacity:0.2;\">\n          <path d=\"M10,10 L90,10 L90,90 L10,90 Z\" fill=\"none\" stroke=\"white\" stroke-width=\"4\" stroke-dasharray=\"320\"\n            stroke-dashoffset=\"320\">\n            <animate attributeName=\"stroke-dashoffset\" from=\"320\" to=\"0\" dur=\"3s\" repeatCount=\"indefinite\" />\n          </path>\n        </svg>\n      </section>\n    </section>\n\n    <section\n      style=\"padding:25px 10px; margin-top:10px; background:white; border-radius:15px; box-shadow:0 5px 20px rgba(0,0,0,0.05);\">\n      <img src=\"https://picsum.photos/600/300?random=1\"\n        style=\"width:100%; height:180px; object-fit:cover; border-radius:12px; margin-bottom:20px; box-shadow:0 4px 10px rgba(0,0,0,0.1);\">\n\n      <h2\n        style=\"font-size:22px; font-weight:700; margin:0 0 15px; padding-bottom:12px; border-bottom:2px solid #d76d77; color:#3a1c71;\">\n        政策急转弯背后的市场警报</h2>\n\n      <p style=\"font-size:16px; margin:0 0 15px; text-align:justify;\">根据国家统计局数据，商品房销售额同比下降<span\n          style=\"color:#d76d77; font-weight:600;\">4.9%</span>，销售面积下降<span\n          style=\"color:#d76d77; font-weight:600;\">7.8%</span>，区域分化明显：东北地区销售额降幅达<span\n          style=\"color:#d76d77; font-weight:600;\">11.0%</span>。房企贷款下降<span\n          style=\"color:#d76d77; font-weight:600;\">11.0%</span>，个人按揭贷款下降<span\n          style=\"color:#d76d77; font-weight:600;\">5.6%</span>，显示资金端压力持续。</p>\n\n      <section\n        style=\"background:#f7f7f7; border-left:4px solid #3a1c71; padding:15px; border-radius:0 8px 8px 0; margin:20px 0;\">\n        <h3 style=\"font-size:16px; margin:0 0 10px; color:#3a1c71;\">关键转折点</h3>\n        <p style=\"font-size:15px; margin:0 0 8px;\">▎房企融资\"三支箭\"落地效果不及预期，信用违约风险向金融机构渗透</p>\n        <p style=\"font-size:15px; margin:0 0 8px;\">▎二手房挂牌量激增引发价格踩踏，成都、武汉等城降价房源占比超<span\n            style=\"font-weight:600;\">60%</span></p>\n        <p style=\"font-size:15px; margin:0;\">▎央行调查显示购房者预期指数降至警戒区间，新增房贷规模同比缩减<span style=\"font-weight:600;\">18%</span>\n        </p>\n      </section>\n    </section>\n\n    <section\n      style=\"padding:25px 10px; margin-top:20px; background:white; border-radius:15px; box-shadow:0 5px 20px rgba(0,0,0,0.05);\">\n      <h2\n        style=\"font-size:22px; font-weight:700; margin:0 0 20px; padding-bottom:12px; border-bottom:2px solid #d76d77; color:#3a1c71;\">\n        政策工具箱里的三把密钥</h2>\n\n      <section style=\"margin-bottom:25px;\">\n        <h3 style=\"font-size:18px; margin:0 0 15px; font-weight:600; color:#d76d77; display:flex; align-items:center;\">\n          <span\n            style=\"display:inline-block; width:24px; height:24px; background:#d76d77; color:white; border-radius:50%; text-align:center; margin-right:10px; line-height:24px;\">1</span>\n          价格管控双轨制\n        </h3>\n        <ul style=\"list-style:none; padding:0; margin:0 0 0 10px;\">\n          <li style=\"margin-bottom:10px;\">\n            <span style=\"color:#3a1c71; margin-right:5px;\">•</span>\n            <strong>新房备案价动态调节</strong>：南京、苏州已建立月度价格波动预警机制\n          </li>\n          <li style=\"margin-bottom:10px;\">\n            <span style=\"color:#3a1c71; margin-right:5px;\">•</span>\n            <strong>二手房指导价2.0</strong>：广州试点\"挂牌价偏离度监测\"，超15%异常房源强制下架\n          </li>\n          <li>\n            <span style=\"color:#3a1c71; margin-right:5px;\">•</span>\n            <strong>限跌令量化标准</strong>：岳阳、唐山等地明确房价跌幅超备案价10%需报备审查\n          </li>\n        </ul>\n      </section>\n\n      <section style=\"margin-bottom:25px;\">\n        <h3 style=\"font-size:18px; margin:0 0 15px; font-weight:600; color:#d76d77; display:flex; align-items:center;\">\n          <span\n            style=\"display:inline-block; width:24px; height:24px; background:#d76d77; color:white; border-radius:50%; text-align:center; margin-right:10px; line-height:24px;\">2</span>\n          信贷政策精准滴灌\n        </h3>\n        <ul style=\"list-style:none; padding:0; margin:0 0 0 10px;\">\n          <li style=\"margin-bottom:10px;\">\n            <span style=\"color:#3a1c71; margin-right:5px;\">•</span>\n            <strong>利率动态调节机制</strong>：郑州、天津试点\"一城一息\"，首套利率较LPR下浮30BP\n          </li>\n          <li style=\"margin-bottom:10px;\">\n            <span style=\"color:#3a1c71; margin-right:5px;\">•</span>\n            <strong>改善需求松绑</strong>：杭州、成都二套房首付降至35%（2023年9月起实施）\n          </li>\n          <li>\n            <span style=\"color:#3a1c71; margin-right:5px;\">•</span>\n            <strong>房企纾困白名单</strong>：50强房企获专项融资额度，债务展期最长可延至2025年\n          </li>\n        </ul>\n      </section>\n\n      <section>\n        <h3 style=\"font-size:18px; margin:0 0 15px; font-weight:600; color:#d76d77; display:flex; align-items:center;\">\n          <span\n            style=\"display:inline-block; width:24px; height:24px; background:#d76d77; color:white; border-radius:50%; text-align:center; margin-right:10px; line-height:24px;\">3</span>\n          供给端制度重构\n        </h3>\n        <ul style=\"list-style:none; padding:0; margin:0 0 0 10px;\">\n          <li style=\"margin-bottom:10px;\">\n            <span style=\"color:#3a1c71; margin-right:5px;\">•</span>\n            <strong>现房销售扩围</strong>：北京、厦门等8城新盘全面实施现房销售\n          </li>\n          <li style=\"margin-bottom:10px;\">\n            <span style=\"color:#3a1c71; margin-right:5px;\">•</span>\n            <strong>预售资金穿透监管</strong>：建立开发商与建筑商\"双向担保\"机制\n          </li>\n          <li>\n            <span style=\"color:#3a1c71; margin-right:5px;\">•</span>\n            <strong>租赁REITs破冰</strong>：首批保障性租赁住房REITs单日认购破纪录达507亿\n          </li>\n        </ul>\n      </section>\n    </section>\n\n    <section\n      style=\"padding:25px 10px; margin-top:20px; background:white; border-radius:15px; box-shadow:0 5px 20px rgba(0,0,0,0.05);\">\n      <h2\n        style=\"font-size:22px; font-weight:700; margin:0 0 20px; padding-bottom:12px; border-bottom:2px solid #d76d77; color:#3a1c71;\">\n        市场正在发生的三大异动</h2>\n\n      <section\n        style=\"background:linear-gradient(to right, rgba(58, 28, 113, 0.05), rgba(215, 109, 119, 0.05)); padding:20px; border-radius:12px; margin-bottom:20px;\">\n        <h3 style=\"font-size:18px; margin:0 0 15px; color:#3a1c71;\">二手房市场现\"冰火两重天\"</h3>\n        <p style=\"display:flex; align-items:center; margin:0 0 10px;\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" style=\"margin-right:10px; fill:#d76d77;\">\n            <path d=\"M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z\"></path>\n          </svg>\n          <span style=\"display: inline-block;\">上海内环豪宅挂牌价逆势上涨<span\n              style=\"color:#d76d77; font-weight:600;\">0.3%</span>（数据来源：链家研究院11月周报）</span>\n        </p>\n        </p>\n        <p style=\"display:flex; align-items:center; margin:0;\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" style=\"margin-right:10px; fill:#d76d77;\">\n            <path d=\"M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z\"></path>\n          </svg>\n          <span style=\"display: inline-block;\">深圳\"负首付\"事件涉及房源占比<span\n              style=\"color:#d76d77; font-weight:600;\">0.3%</span>（深圳市住建局专项检查通报）</span>\n        </p>\n      </section>\n\n      <section\n        style=\"background:linear-gradient(to right, rgba(58, 28, 113, 0.05), rgba(215, 109, 119, 0.05)); padding:20px; border-radius:12px; margin-bottom:20px;\">\n        <h3 style=\"font-size:18px; margin:0 0 15px; color:#3a1c71;\">土地市场暗流涌动</h3>\n        <p style=\"display:flex; align-items:center; margin:0 0 10px;\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" style=\"margin-right:10px; fill:#d76d77;\">\n            <path d=\"M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z\"></path>\n          </svg>\n          <span style=\"display: inline-block;\">合肥第三轮土拍地方城投托底比例降至<span\n              style=\"color:#d76d77; font-weight:600; \">40%</span>（中国指数研究院土地月报）</span>\n        </p>\n        <p style=\"display:flex; align-items:center; margin:0;\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" style=\"margin-right:10px; fill:#d76d77;\">\n            <path d=\"M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z\"></path>\n          </svg>\n          <span style=\"display: inline-block;\">万科等央企三季度新增土储同比增长<span\n              style=\"color:#d76d77; font-weight:600;\">25%</span>（企业季报数据）</span>\n        </p>\n      </section>\n\n      <section\n        style=\"background:linear-gradient(to right, rgba(58, 28, 113, 0.05), rgba(215, 109, 119, 0.05)); padding:20px; border-radius:12px;\">\n        <h3 style=\"font-size:18px; margin:0 0 15px; color:#3a1c71;\">金融创新与风险并存</h3>\n        <p style=\"display:flex; align-items:center; margin:0 0 10px;\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" style=\"margin-right:10px; fill:#d76d77;\">\n            <path d=\"M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z\"></path>\n          </svg>\n          <span style=\"display: inline-block;\">建筑企业商票违约率升至<span\n              style=\"color:#d76d77; font-weight:600;\">11.8%</span>（上海票据交易所10月风险提示）</span>\n        </p>\n        <p style=\"display:flex; align-items:center; margin:0;\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" style=\"margin-right:10px; fill:#d76d77;\">\n            <path d=\"M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z\"></path>\n          </svg>\n          <span style=\"display: inline-block;\">RMBS产品年化收益率中枢维持在<span\n              style=\"color:#d76d77; font-weight:600;\">5.2%</span>（中债估值中心数据）</span>\n        </p>\n      </section>\n    </section>\n\n    <section\n      style=\"padding:25px 10px; margin-top:20px; background:white; border-radius:15px; box-shadow:0 5px 20px rgba(0,0,0,0.05);\">\n      <h2\n        style=\"font-size:22px; font-weight:700; margin:0 0 20px; padding-bottom:12px; border-bottom:2px solid #d76d77; color:#3a1c71;\">\n        政策背后的三重博弈</h2>\n\n      <section style=\"display:flex; margin-bottom:20px; gap:15px; flex-direction:column;\">\n        <section\n          style=\"flex:1; padding:15px; border-radius:12px; background:#f9f9f9; box-shadow:0 2px 8px rgba(0,0,0,0.05);\">\n          <h3 style=\"font-size:17px; color:#3a1c71; margin:0 0 10px; display:flex; align-items:center;\">\n            <span\n              style=\"display:inline-block; width:22px; height:22px; background:#3a1c71; color:white; border-radius:50%; text-align:center; margin-right:8px; line-height:22px; font-size:14px;\">1</span>\n            行政干预与市场规律的角力\n          </h3>\n          <p style=\"margin:0; font-size:15px;\">南京某项目通过\"装修升级包\"方式实现实际降价<span\n              style=\"color:#d76d77; font-weight:600;\">12%</span>（市住建局行政处罚公示）</p>\n        </section>\n\n        <section\n          style=\"flex:1; padding:15px; border-radius:12px; background:#f9f9f9; box-shadow:0 2px 8px rgba(0,0,0,0.05);\">\n          <h3 style=\"font-size:17px; color:#3a1c71; margin:0 0 10px; display:flex; align-items:center;\">\n            <span\n              style=\"display:inline-block; width:22px; height:22px; background:#3a1c71; color:white; border-radius:50%; text-align:center; margin-right:8px; line-height:22px; font-size:14px;\">2</span>\n            中央统筹与地方执行的温差\n          </h3>\n          <p style=\"margin:0; font-size:15px;\">某省会城市人才购房补贴扩大至非全日制本科（地方政府官网公告）</p>\n        </section>\n\n        <section\n          style=\"flex:1; padding:15px; border-radius:12px; background:#f9f9f9; box-shadow:0 2px 8px rgba(0,0,0,0.05);\">\n          <h3 style=\"font-size:17px; color:#3a1c71; margin:0 0 10px; display:flex; align-items:center;\">\n            <span\n              style=\"display:inline-block; width:22px; height:22px; background:#3a1c71; color:white; border-radius:50%; text-align:center; margin-right:8px; line-height:22px; font-size:14px;\">3</span>\n            短期维稳与长效改革的平衡\n          </h3>\n          <p style=\"margin:0; font-size:15px;\">全国38城二手房空置率超<span\n              style=\"color:#d76d77; font-weight:600;\">18%</span>（贝壳研究院《2023住房空置调查报告》）</p>\n        </section>\n      </section>\n    </section>\n\n    <section\n      style=\"padding:25px 10px; margin-top:20px; background:white; border-radius:15px; box-shadow:0 5px 20px rgba(0,0,0,0.05);\">\n      <h2\n        style=\"font-size:22px; font-weight:700; margin:0 0 20px; padding-bottom:12px; border-bottom:2px solid #d76d77; color:#3a1c71;\">\n        购房者决策指南（2023-2024）</h2>\n\n      <section style=\"border-radius:12px; overflow:hidden; margin-bottom:20px; box-shadow:0 2px 8px rgba(0,0,0,0.05);\">\n        <section style=\"background:#3a1c71; color:white; padding:12px 15px; font-weight:600; display:flex;\">\n          <section style=\"flex:1.5;\">城市类型</section>\n          <section style=\"flex:2;\">策略建议</section>\n          <section style=\"flex:2;\">风险预警</section>\n        </section>\n\n        <section style=\"display:flex; border-bottom:1px solid #eee; background:#fff;\">\n          <section style=\"flex:1.5; padding:12px 15px; font-weight:600;\">一线城市</section>\n          <section style=\"flex:2; padding:12px 15px;\">关注核心区改善型产品</section>\n          <section style=\"flex:2; padding:12px 15px;\">警惕学区房政策变动风险</section>\n        </section>\n\n        <section style=\"display:flex; border-bottom:1px solid #eee; background:#f9f9f9;\">\n          <section style=\"flex:1.5; padding:12px 15px; font-weight:600;\">强二线城市</section>\n          <section style=\"flex:2; padding:12px 15px;\">把握政策窗口期置换升级</section>\n          <section style=\"flex:2; padding:12px 15px;\">防范远郊项目烂尾风险</section>\n        </section>\n\n        <section style=\"display:flex; background:#fff;\">\n          <section style=\"flex:1.5; padding:12px 15px; font-weight:600;\">三四线城市</section>\n          <section style=\"flex:2; padding:12px 15px;\">优先现房或央企项目</section>\n          <section style=\"flex:2; padding:12px 15px;\">警惕价格战中的质量陷阱</section>\n        </section>\n      </section>\n\n      <section style=\"background:#f7f7f7; border-left:4px solid #d76d77; padding:15px; border-radius:0 8px 8px 0;\">\n        <p style=\"font-size:15px; margin:0; font-weight:600; color:#3a1c71;\">专家提醒</p>\n        <p style=\"font-size:15px; margin:5px 0 0;\">建议增加6个月市场观察期，重点监测房企现金流指标（净负债率>100%需预警）。</p>\n      </section>\n    </section>\n\n    <section\n      style=\"padding:25px 10px; margin-top:20px; background:white; border-radius:15px; box-shadow:0 5px 20px rgba(0,0,0,0.05);\">\n      <h2\n        style=\"font-size:22px; font-weight:700; margin:0 0 20px; padding-bottom:12px; border-bottom:2px solid #d76d77; color:#3a1c71;\">\n        制度变革深水区</h2>\n\n      <section style=\"margin-bottom:25px;\">\n        <h3 style=\"font-size:18px; font-weight:600; margin:0 0 15px; color:#3a1c71;\">土地财政转型实验</h3>\n        <section style=\"display:flex; flex-direction:column; gap:12px;\">\n          <section style=\"display:flex; align-items:flex-start;\">\n            <span style=\"color:#d76d77; font-weight:bold; margin-right:10px;\">▎</span>\n            <p style=\"margin:0; flex:1;\">深圳前海试点商办用地转保障性住房（规划建筑面积82万㎡）</p>\n          </section>\n          <section style=\"display:flex; align-items:flex-start;\">\n            <span style=\"color:#d76d77; font-weight:bold; margin-right:10px;\">▎</span>\n            <p style=\"margin:0; flex:1;\">成都土拍引入\"房价承诺+品质竞标\"复合评标机制</p>\n          </section>\n        </section>\n      </section>\n\n      <section>\n        <h3 style=\"font-size:18px; font-weight:600; margin:0 0 15px; color:#3a1c71;\">住房双轨制突破</h3>\n        <section style=\"display:flex; flex-direction:column; gap:12px;\">\n          <section style=\"display:flex; align-items:flex-start;\">\n            <span style=\"color:#d76d77; font-weight:bold; margin-right:10px;\">▎</span>\n            <p style=\"margin:0; flex:1;\">北京共有产权房转商政策明确补缴价款计算方式（评估价×35%）</p>\n          </section>\n          <section style=\"display:flex; align-items:flex-start;\">\n            <span style=\"color:#d76d77; font-weight:bold; margin-right:10px;\">▎</span>\n            <p style=\"margin:0; flex:1;\">广州租赁备案证明可作为义务教育入学辅助材料</p>\n          </section>\n        </section>\n      </section>\n      </dsectioniv>\n\n      <section\n        style=\"padding:25px 10px; margin-top:20px; background:white; border-radius:15px; box-shadow:0 5px 20px rgba(0,0,0,0.05); margin-bottom:30px;\">\n        <section\n          style=\"background:linear-gradient(135deg, rgba(58, 28, 113, 0.05), rgba(215, 109, 119, 0.05)); padding:20px; border-radius:12px;\">\n          <h3 style=\"font-size:18px; margin:0 0 15px; color:#3a1c71; font-weight:600;\">历史镜鉴</h3>\n          <p style=\"font-size:15px; line-height:1.7; margin:0; text-align:justify;\">\n            对比日本1991年楼市调控，政策应注重构建市场化风险缓释机制。住建部新政明确要求2024年底前基本建立租购并举制度，房企应加快从\"<span\n              style=\"color:#d76d77; font-weight:600;\">高杠杆</span>\"向\"<span\n              style=\"color:#3a1c71; font-weight:600;\">高品质</span>\"转型，购房者需建立\"居住属性优先\"的资产配置逻辑。</p>\n        </section>\n\n        <section style=\"margin-top:25px; display:flex; justify-content:center;\">\n          <svg width=\"280\" height=\"60\" viewBox=\"0 0 280 60\">\n            <path d=\"M10,30 C50,10 80,50 140,30 C200,10 230,50 270,30\" fill=\"none\" stroke=\"#d76d77\" stroke-width=\"2\"\n              stroke-dasharray=\"5,5\">\n              <animate attributeName=\"d\"\n                values=\"M10,30 C50,10 80,50 140,30 C200,10 230,50 270,30;M10,30 C50,50 80,10 140,30 C200,50 230,10 270,30;M10,30 C50,10 80,50 140,30 C200,10 230,50 270,30\"\n                dur=\"8s\" repeatCount=\"indefinite\" />\n            </path>\n            <circle cx=\"70\" cy=\"30\" r=\"5\" fill=\"#3a1c71\">\n              <animate attributeName=\"cy\" values=\"30;20;40;30\" dur=\"8s\" repeatCount=\"indefinite\" />\n            </circle>\n            <circle cx=\"140\" cy=\"30\" r=\"5\" fill=\"#d76d77\">\n              <animate attributeName=\"cy\" values=\"30;40;20;30\" dur=\"8s\" repeatCount=\"indefinite\" />\n            </circle>\n            <circle cx=\"210\" cy=\"30\" r=\"5\" fill=\"#3a1c71\">\n              <animate attributeName=\"cy\" values=\"30;20;40;30\" dur=\"8s\" repeatCount=\"indefinite\" />\n            </circle>\n            <text x=\"70\" y=\"55\" text-anchor=\"middle\" fill=\"#3a1c71\" style=\"font-size:10px;\">短期波动</text>\n            <text x=\"140\" y=\"55\" text-anchor=\"middle\" fill=\"#d76d77\" style=\"font-size:10px;\">政策调节</text>\n            <text x=\"210\" y=\"55\" text-anchor=\"middle\" fill=\"#3a1c71\" style=\"font-size:10px;\">长期趋势</text>\n          </svg>\n        </section>\n      </section>\n    </section>\n</body>\n\n</html>"
  },
  "html": "<section style=\"box-sizing: border-box\" id=\"cw-layout-imported\"><section style=\"background: linear-gradient(135deg, #f9f9f9, #ffffff); box-sizing: border-box; color: #333; font-family: 'PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif; line-height: 1.6; margin: 0 auto; max-width: 100%; padding: 0\"><section style=\"background: linear-gradient(135deg, rgb(58, 28, 113), rgb(215, 109, 119)); border: 1px solid rgba(0, 0, 0, 0.08); border-radius: 0px 0px 25px 25px; box-sizing: border-box; color: white; display: block; padding: 25px 10px; margin-top: 0px; margin-bottom: 0px;\"><section style=\"box-sizing: border-box; display: inline-block; vertical-align: top; width: 100%; padding-top: 0px; padding-bottom: 0px; margin-top: 0px; margin-bottom: 0px;\"><p style=\"box-sizing: border-box; font-size: 16px; font-weight: 300; margin: 0px 0px 15px; overflow-wrap: anywhere; text-indent: 0px;\">开场第一段：比赛结束后，人们先看到了比分。阅读一篇文章，也需要先交代背景，让读者知道事情从哪里开始。</p></section></section><section style=\"background: white; border: 1px solid rgba(0,0,0,0.08); border-radius: 15px; box-sizing: border-box; margin-top: 10px; padding: 25px 10px\"><p style=\"box-sizing: border-box; color: #333; font-size: 16px; line-height: 1.8; margin: 0 0 15px; padding: 12px 15px; text-align: justify; width: 100%\">开场第二段：比分接近，真正需要讨论的是关键时刻的判断。连续的正文应留在同一个阅读容器里，左右都应有清楚的留白。</p><p style=\"box-sizing: border-box; color: #333; font-size: 16px; line-height: 1.8; margin: 0 0 15px; padding: 12px 15px; text-align: justify; width: 100%\">开场第三段：接下来再进入具体章节。段落数量改变时，不应丢失内容，不应贴边，也不应为每段重复一层巨大的卡片内边距。</p></section><section><p style=\"border: 1px solid rgba(0,0,0,0.08); border-radius: 12px; box-sizing: border-box; display: block; font-size: 16px; height: auto; line-height: 1.8; margin: 0 0 18px; margin-bottom: 20px; max-width: 100%; padding: 12px 15px; width: 100%\"><img src=\"https://api.gitcode.com/api/v5/repos/wendao-ai/wendao-ai-template-market/raw/sample-images/reading-still-life.jpg?ref=master&v=0537832c544b1da46e9132fbf0b360b50d94e840b6077ec13a6f57c5c0ab925c\" alt=\"自然光下的阅读与写作静物\" style=\"display: block; height: auto; margin: 16px 0; max-width: 100%; width: 100%\"></p></section><section style=\"background: white; border: 1px solid rgba(0,0,0,0.08); border-radius: 15px; box-sizing: border-box; margin-top: 10px; padding: 25px 10px\"><h2 style=\"border-bottom: 2px solid #d76d77; box-sizing: border-box; color: #3a1c71; font-size: 22px; font-weight: 700; margin: 0 0 15px; overflow-wrap: anywhere; padding-bottom: 12px; text-indent: 0\">从标题开始，建立阅读节奏</h2><section><p style=\"box-sizing: border-box; color: #333; font-size: 16px; line-height: 1.8; margin: 0 0 15px; padding: 12px 15px; text-align: justify; width: 100%\">标题需要一个清楚的重心。<strong style=\"box-sizing: border-box\">重点句只强调一次</strong>，其余正文让段落长度、行距和留白承担节奏。</p></section><section><blockquote style=\"border-left: 3px solid #94a3b8; margin: 18px 0; padding: 12px 16px\"><p style=\"box-sizing: border-box; font-size: 16px; line-height: 1.8; margin: 0 0 18px; padding: 12px 15px; width: 100%\">排版的任务，是把内容的关系呈现出来。</p></blockquote></section><section><p style=\"box-sizing: border-box; color: #333; font-size: 16px; line-height: 1.8; margin: 0 0 15px; padding: 12px 15px; text-align: justify; width: 100%\">每种风格都应该有自己的声音，同时让正文保持完整、清楚和可读。</p></section></section><section style=\"background: white; border: 1px solid rgba(0,0,0,0.08); border-radius: 15px; box-sizing: border-box; margin-top: 20px; padding: 25px 10px\"><h2 style=\"border-bottom: 2px solid #d76d77; box-sizing: border-box; color: #3a1c71; font-size: 22px; font-weight: 700; margin: 0 0 20px; overflow-wrap: anywhere; padding-bottom: 12px; text-indent: 0\">三个可以马上检查的地方</h2><section><ul style=\"box-sizing: border-box; list-style: none; margin: 0 0 0 10px; padding: 0\"><li style=\"box-sizing: border-box; margin-bottom: 10px\">标题是否有独立的视觉重心</li><li style=\"box-sizing: border-box; margin-bottom: 10px\">章节之间是否留出呼吸空间</li><li style=\"box-sizing: border-box; margin-bottom: 10px\">重点是否与普通正文形成清楚层级</li></ul></section><section><p style=\"border: 1px solid rgba(0,0,0,0.08); border-radius: 12px; box-sizing: border-box; display: block; font-size: 16px; height: auto; line-height: 1.8; margin: 0 0 18px; margin-bottom: 20px; max-width: 100%; padding: 12px 15px; width: 100%\"><img src=\"https://api.gitcode.com/api/v5/repos/wendao-ai/wendao-ai-template-market/raw/sample-images/reading-still-life.jpg?ref=master&v=0537832c544b1da46e9132fbf0b360b50d94e840b6077ec13a6f57c5c0ab925c\" alt=\"自然光下的阅读与写作静物\" style=\"display: block; height: auto; margin: 16px 0; max-width: 100%; width: 100%\"></p></section><section><p style=\"border: 1px solid rgba(0,0,0,0.08); border-radius: 12px; box-sizing: border-box; display: block; font-size: 16px; height: auto; line-height: 1.8; margin: 0 0 18px; margin-bottom: 20px; max-width: 100%; padding: 12px 15px; width: 100%\"><img src=\"https://api.gitcode.com/api/v5/repos/wendao-ai/wendao-ai-template-market/raw/sample-images/reading-still-life.jpg?ref=master&v=0537832c544b1da46e9132fbf0b360b50d94e840b6077ec13a6f57c5c0ab925c\" alt=\"自然光下的阅读与写作静物\" style=\"display: block; height: auto; margin: 16px 0; max-width: 100%; width: 100%\"></p></section><section><table style=\"border-collapse: collapse; margin: 18px 0; table-layout: fixed; width: 100%\"><thead><tr><th style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">检查项</th><th style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">观察方式</th></tr></thead><tbody><tr><td style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">标题</td><td style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">第一眼能否找到主题</td></tr><tr><td style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">正文</td><td style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">是否能够连续阅读</td></tr><tr><td style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">引用</td><td style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">是否与作者叙述区分</td></tr></tbody></table></section><section><p style=\"border: 1px solid rgba(0,0,0,0.08); border-radius: 12px; box-sizing: border-box; display: block; font-size: 16px; height: auto; line-height: 1.8; margin: 0 0 18px; margin-bottom: 20px; max-width: 100%; padding: 12px 15px; width: 100%\"><img src=\"https://api.gitcode.com/api/v5/repos/wendao-ai/wendao-ai-template-market/raw/sample-images/reading-still-life.jpg?ref=master&v=0537832c544b1da46e9132fbf0b360b50d94e840b6077ec13a6f57c5c0ab925c\" alt=\"自然光下的阅读与写作静物\" style=\"display: block; height: auto; margin: 16px 0; max-width: 100%; width: 100%\"></p></section></section><section style=\"background: white; border: 1px solid rgba(0,0,0,0.08); border-radius: 15px; box-sizing: border-box; margin-top: 20px; padding: 25px 10px\"><h2 style=\"border-bottom: 2px solid #d76d77; box-sizing: border-box; color: #3a1c71; font-size: 22px; font-weight: 700; margin: 0 0 20px; overflow-wrap: anywhere; padding-bottom: 12px; text-indent: 0\">把风格落实到每一个细节</h2><section style=\"box-sizing: border-box; display: block; margin-bottom: 20px\"><section style=\"background: #f9f9f9; border: 1px solid rgba(0,0,0,0.08); border-radius: 12px; box-sizing: border-box; padding: 15px; width: 100%\"><p style=\"box-sizing: border-box; color: #333; font-size: 15px; line-height: 1.8; margin: 0; padding: 12px 15px; width: 100%\">报纸用硬边栏线建立秩序，杂志用大留白放慢速度，信笺让段落像一次自然的交谈。</p></section><section><p style=\"border: 1px solid rgba(0,0,0,0.08); border-radius: 12px; box-sizing: border-box; display: block; font-size: 16px; height: auto; line-height: 1.8; margin: 0 0 18px; margin-bottom: 20px; max-width: 100%; padding: 12px 15px; width: 100%\"><img src=\"https://api.gitcode.com/api/v5/repos/wendao-ai/wendao-ai-template-market/raw/sample-images/reading-still-life.jpg?ref=master&v=0537832c544b1da46e9132fbf0b360b50d94e840b6077ec13a6f57c5c0ab925c\" alt=\"自然光下的阅读与写作静物\" style=\"display: block; height: auto; margin: 16px 0; max-width: 100%; width: 100%\"></p></section><section style=\"background: #f9f9f9; border: 1px solid rgba(0,0,0,0.08); border-radius: 12px; box-sizing: border-box; padding: 15px; width: 100%\"><p style=\"box-sizing: border-box; color: #333; font-size: 15px; line-height: 1.8; margin: 0; padding: 12px 15px; width: 100%\">一个完整的句子，不应该为了装饰被删掉。一张原有的表格，也不应该被换成没有事实来源的数字。</p></section><section style=\"background: #f9f9f9; border: 1px solid rgba(0,0,0,0.08); border-radius: 12px; box-sizing: border-box; padding: 15px; width: 100%\"><p style=\"box-sizing: border-box; color: #333; font-size: 15px; line-height: 1.8; margin: 0; padding: 12px 15px; width: 100%\">读完之后，留下一个清楚的观点，比留下许多重复的色块更有价值。</p></section></section></section></section></section>",
