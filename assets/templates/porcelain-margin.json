0 0 18px\"},\"heading\":{\"display\":\"block\",\"width\":\"auto\",\"color\":\"#204640\",\"background\":\"transparent\",\"border\":\"0\",\"padding\":\"0\",\"margin\":\"0 0 16px\",\"line-height\":\"1.5\",\"text-align\":\"right\",\"font-size\":\"24px\",\"font-weight\":\"400\",\"padding-bottom\":\"14px\",\"border-bottom\":\"1px solid #216b60\"},\"quote\":{\"margin\":\"24px 0\",\"line-height\":\"1.85\",\"color\":\"#204640\",\"border\":\"0\",\"border-top\":\"1px solid #216b60\",\"border-bottom\":\"1px solid #216b60\",\"background\":\"transparent\",\"padding\":\"22px 10px\",\"text-align\":\"center\",\"font-size\":\"20px\"},\"ending\":{\"font-size\":\"16px\",\"color\":\"#204640\",\"line-height\":\"1.95\",\"margin\":\"32px 0 0\",\"border\":\"0\",\"border-top\":\"1px solid #41685e\",\"padding\":\"18px 0 0\"},\"image\":{\"margin\":\"24px 0\"},\"table\":{\"font-size\":\"15px\",\"line-height\":\"1.7\"}},\"chapters\":[{\"width\":\"88%\",\"margin\":\"32px 0 0 auto\",\"padding\":\"16px 0\",\"background\":\"transparent\"},{\"width\":\"100%\",\"margin\":\"32px 0 0\",\"padding\":\"24px 18px\",\"background-color\":\"#dfeee7\"}],\"headingSurface\":{},\"bodySurface\":{},\"initial\":{}},\"blocks\":[]}]",
