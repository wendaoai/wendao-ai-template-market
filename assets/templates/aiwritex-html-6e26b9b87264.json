lor: #444; font-size: 17px; font-weight: 500; line-height: 1.7\"},\"sections\":{\"2\":[{\"frame\":\"\\u003csection style=\\\"background-color: white; border: 1px solid rgba(0,0,0,0.08); border-radius: 15px; box-sizing: border-box; margin: 0 20px 25px; padding: 25px\\\"\\u003e\\u003csection style=\\\"box-sizing: border-box; display: block; margin-bottom: 20px\\\"\\u003e\\u003ch2 style=\\\"box-sizing: border-box; color: #3a6186; font-size: 24px; font-weight: 700; margin-left: 15px; overflow-wrap: anywhere; text-indent: 0; width: 100%\\\"\\u003e{{heading}}\\u003c/h2\\u003e\\u003c/section\\u003e\\u003csection style=\\\"box-sizing: border-box; color: #444; font-size: 16px; line-height: 1.7\\\"\\u003e{{body}}\\u003c/section\\u003e\\u003c/section\\u003e\",\"paragraph\":{\"frame\":\"\\u003csection\\u003e{{content}}\\u003c/section\\u003e\",\"style\":\"box-sizing: border-box; color: #444; margin-top: 0\"},\"image\":{\"frame\":\"\"}},{\"frame\":\"\\u003csection style=\\\"background-color: #3a6186; border: 1px solid rgba(0,0,0,0.08); border-radius: 15px; box-sizing: border-box; color: white; margin: 0 20px 25px; padding: 25px\\\"\\u003e\\u003ch2 style=\\\"box-sizing: border-box; font-size: 22px; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 15px; overflow-wrap: anywhere; text-indent: 0\\\"\\u003e{{heading}}\\u003c/h2\\u003e{{body}}\\u003c/section\\u003e\",\"paragraph\":{\"frame\":\"\\u003csection style=\\\"box-sizing: border-box; font-size: 16px; line-height: 1.7\\\"\\u003e{{content}}\\u003c/section\\u003e\",\"style\":\"box-sizing: border-box; color: white; margin-top: 0\"},\"image\":{\"frame\":\"\"}}]},\"blocks\":{\"body\":{\"frame\":\"\\u003csection\\u003e{{content}}\\u003c/section\\u003e\",\"style\":\"box-sizing: border-box; font-size: 16px; line-height: 1.8; margin: 0 0 18px\"},\"image\":{\"frame\":\"\\u003csection\\u003e{{content}}\\u003c/section\\u003e\"},\"list\":{\"frame\":\"\\u003csection\\u003e{{content}}\\u003c/section\\u003e\",\"style\":\"box-sizing: borde