der\":\"0\",\"padding\":\"12px 0\",\"margin\":\"0 0 16px\",\"line-height\":\"1.5\",\"font-size\":\"23px\",\"font-weight\":\"500\",\"text-align\":\"center\"},\"quote\":{\"margin\":\"24px 0\",\"line-height\":\"1.85\",\"color\":\"#302c27\",\"font-style\":\"italic\",\"text-align\":\"center\",\"font-size\":\"21px\",\"border\":\"0\",\"padding\":\"20px 14px\",\"background\":\"transparent\"},\"ending\":{\"font-size\":\"16px\",\"color\":\"#302c27\",\"line-height\":\"1.95\",\"margin\":\"32px 0 0\",\"border\":\"0\",\"border-top\":\"1px solid #716052\",\"padding\":\"18px 0 0\"},\"image\":{\"margin\":\"24px 0\"},\"table\":{\"font-size\":\"15px\",\"line-height\":\"1.7\"}},\"chapters\":[{\"width\":\"100%\",\"margin\":\"32px 0 0\",\"padding\":\"12px 0 0\",\"border\":\"0\",\"border-top\":\"1px solid #ede4d4\"}],\"headingSurface\":{},\"bodySurface\":{},\"initial\":{\"display\":\"inline-block\",\"font-size\":\"42px\",\"line-height\":\"1\",\"margin-right\":\"6px\",\"color\":\"#804331\"}},\"blocks\":[]}]",
