ng\":{\"display\":\"block\",\"width\":\"auto\",\"color\":\"#4e6a3c\",\"background\":\"transparent\",\"border\":\"0\",\"padding\":\"0\",\"margin\":\"0 0 16px\",\"line-height\":\"1.5\",\"font-size\":\"23px\",\"font-weight\":\"500\",\"border-bottom\":\"1px solid #4e6a3c\",\"padding-bottom\":\"14px\"},\"quote\":{\"margin\":\"24px 0\",\"line-height\":\"1.85\",\"color\":\"#334331\",\"font-size\":\"18px\",\"font-style\":\"italic\",\"border\":\"1px solid #67725b\",\"padding\":\"22px\",\"background-color\":\"#e1e5cf\"},\"ending\":{\"font-size\":\"16px\",\"color\":\"#334331\",\"line-height\":\"1.95\",\"margin\":\"32px 0 0\",\"border\":\"0\",\"border-top\":\"1px solid #67725b\",\"padding\":\"18px 0 0\"},\"image\":{\"margin\":\"24px 0\",\"border\":\"1px solid #67725b\",\"padding\":\"9px\",\"background-color\":\"#f3f2e6\"},\"table\":{\"font-size\":\"15px\",\"line-height\":\"1.7\"}},\"chapters\":[{\"width\":\"100%\",\"padding\":\"18px 0\",\"margin\":\"32px 0 0\",\"border\":\"0\",\"background\":\"transparent\"}],\"headingSurface\":{},\"bodySurface\":{},\"initial\":{}},\"blocks\":[]}]",
