gin\":\"0 0 18px\"},\"heading\":{\"display\":\"block\",\"width\":\"auto\",\"color\":\"#944c2c\",\"background\":\"transparent\",\"border\":\"0\",\"padding\":\"0\",\"margin\":\"0 0 16px\",\"line-height\":\"1.5\",\"font-size\":\"24px\",\"font-weight\":\"500\",\"padding-bottom\":\"16px\"},\"quote\":{\"margin\":\"24px 0\",\"line-height\":\"1.85\",\"color\":\"#523e2c\",\"font-size\":\"19px\",\"font-style\":\"italic\",\"border\":\"0\",\"border-right\":\"1px solid #944c2c\",\"padding\":\"20px 20px 20px 0\",\"background\":\"transparent\",\"text-align\":\"right\"},\"ending\":{\"font-size\":\"16px\",\"color\":\"#523e2c\",\"line-height\":\"1.95\",\"margin\":\"32px 0 0\",\"border\":\"0\",\"border-top\":\"1px solid #826149\",\"padding\":\"18px 0 0\"},\"image\":{\"margin\":\"24px 0\"},\"table\":{\"font-size\":\"15px\",\"line-height\":\"1.7\"}},\"chapters\":[{\"width\":\"100%\",\"margin\":\"32px 0 0\",\"padding\":\"18px 0\",\"border\":\"0\",\"background\":\"transparent\"},{\"width\":\"90%\",\"margin\":\"32px 0 0 auto\",\"padding\":\"22px 16px\",\"border\":\"1px dashed #826149\",\"background-color\":\"#e8d6be\"}],\"headingSurface\":{},\"bodySurface\":{},\"initial\":{}},\"blocks\":[]}]",
