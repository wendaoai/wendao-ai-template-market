n\":\"0 0 16px\",\"line-height\":\"1.5\",\"font-size\":\"25px\",\"font-weight\":\"400\",\"border-bottom\":\"1px solid #264ba3\",\"padding-bottom\":\"16px\"},\"quote\":{\"margin\":\"24px 0\",\"line-height\":\"1.85\",\"color\":\"#263c69\",\"font-size\":\"21px\",\"font-weight\":\"400\",\"border\":\"0\",\"padding\":\"26px 20px\",\"text-align\":\"center\",\"background-color\":\"#e2e5ed\"},\"ending\":{\"font-size\":\"16px\",\"color\":\"#263c69\",\"line-height\":\"1.95\",\"margin\":\"32px 0 0\",\"border\":\"0\",\"border-top\":\"1px solid #5b6c8e\",\"padding\":\"18px 0 0\"},\"image\":{\"margin\":\"24px 0\",\"padding\":\"12px\",\"border\":\"1px solid #5b6c8e\",\"background-color\":\"#f4f2e9\"},\"table\":{\"font-size\":\"15px\",\"line-height\":\"1.7\"}},\"chapters\":[{\"width\":\"100%\",\"padding\":\"18px 0\",\"margin\":\"34px 0 0\",\"border\":\"0\",\"background\":\"transparent\"}],\"headingSurface\":{},\"bodySurface\":{},\"initial\":{}},\"blocks\":[]}]",
