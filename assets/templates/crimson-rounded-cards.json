us: 8px; box-sizing: border-box; margin-right: 15px; max-width: 100%; width: 80px\\\">{{content}}</section>\",\"style\":\"border-radius: 8px; box-sizing: border-box; display: block; height: auto; max-width: 100%; width: 100%\"}}]},\"blocks\":{\"body\":{\"frame\":\"<section>{{content}}</section>\",\"style\":\"box-sizing: border-box; font-size: 16px; font-weight: 600; line-height: 1.8; margin: 0\"},\"image\":{\"frame\":\"<section>{{content}}</section>\",\"style\":\"box-sizing: border-box; display: block; height: auto; max-width: 100%; width: 100%\"},\"list\":{\"frame\":\"<section>{{content}}</section>\"},\"note\":{\"frame\":\"<section>{{content}}</section>\"},\"quote\":{\"frame\":\"<section>{{content}}</section>\",\"style\":\"border: 0; border-left: 0; margin: 0; padding: 0\",\"textStyle\":\"box-sizing: border-box; color: #666; font-size: 15px; font-style: italic; margin: 0\"},\"rule\":{\"frame\":\"<section>{{content}}</section>\"},\"table\":{\"frame\":\"<section>{{content}}</section>\"}}}}]",
