  "schemaVersion": 1,
  "id": "aiwritex-html-fd813e3df8d0",
  "type": "html-template",
  "original": {
    "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>娱乐圈内幕</title>\n</head>\n\n<body>\n    <section\n        style=\"max-width: 100%; margin: 0; padding: 0; background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%); font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif; color: #333; line-height: 1.6;\">\n\n        <!-- 头部标题区 -->\n        <section\n            style=\"padding: 10px; margin: 0; background: linear-gradient(135deg, #ff3366 0%, #ff5e62 100%); color: white; border-radius: 0 0 25px 25px; box-shadow: 0 4px 15px rgba(255, 51, 102, 0.3);\">\n            <h1\n                style=\"margin: 0; padding: 10px 0; font-size: 28px; font-weight: 900; letter-spacing: 1px; text-align: center; text-shadow: 0 2px 4px rgba(0,0,0,0.2);\">\n                娱乐圈惊爆内幕</h1>\n            <section style=\"display: flex; justify-content: space-between; align-items: center; margin-top: 10px;\">\n                <span style=\"font-size: 14px; opacity: 0.9;\">EXCLUSIVE</span>\n                <span style=\"font-size: 14px; opacity: 0.9;\">2025.06.28</span>\n            </section>\n        </section>\n\n        <!-- 导语区 -->\n        <section\n            style=\"margin: 10px; padding: 25px; background-color: white; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.08);\">\n            <p\n                style=\"font-size: 18px; font-weight: 600; margin: 0 0 15px 0; color: #333; border-left: 4px solid #ff3366; padding-left: 15px; line-height: 1.4;\">\n                娱乐圈从来不缺少话题，明星们的恋情、分手、复合、综艺、电影、幕后故事......每一个细节都牵动着亿万粉丝的心。今天，我们将为您揭秘近期娱乐圈最劲爆的内幕！\n            </p>\n        </section>\n\n        <!-- 热点新闻1 -->\n        <section\n            style=\"margin: 10px; padding: 0; background-color: white; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.08); overflow: hidden; display: flex; flex-direction: column; min-width: 0;\">\n            <section style=\"width: 100%; height: 200px; flex-shrink: 0; overflow: hidden;\">\n                <img src=\"https://picsum.photos/600/400?random=1\" alt=\"热点新闻图片\"\n                    style=\"width: 100%; height: 200px; object-fit: cover; display: block; max-width: 100%; max-height: 200px;\">\n            </section>\n            <section style=\"padding: 20px; flex-grow: 1;\">\n                <h2 style=\"margin: 0 0 15px 0; font-size: 22px; font-weight: 700; color: #222; line-height: 1.3;\">\n                    <svg style=\"width: 24px; height: 24px; vertical-align: middle; margin-right: 8px; fill: #ff3366;\"\n                        viewBox=\"0 0 24 24\">\n                        <path\n                            d=\"M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z\">\n                        </path>\n                    </svg>\n                    顶流CP官宣？两人疑似同居被拍\n                </h2>\n                <p style=\"margin: 0 0 15px 0; font-size: 16px; line-height: 1.8; color: #555;\">\n                    娱乐圈最受瞩目的\"双A\"组合——安潇和艾莉近日被狗仔队拍到同时进出某高档小区，引发粉丝热议。据知情人士透露，两人在合作新剧《星河传说》期间暗生情愫，早已私下交往多月。两位明星的工作室虽发表声明称\"纯属工作关系\"，但多张同框照片和细节分析似乎暗示着不一样的故事。\n                </p>\n                <p style=\"margin: 0 0 15px 0; font-size: 16px; line-height: 1.8; color: #555;\">\n                    资深娱乐记者王媛表示：\"从两人近期的社交媒体互动和同款饰品来看，确实存在超出普通合作关系的可能。安潇最近的一条动态'遇见你，是我生命中最美好的意外'，很可能就是在暗示这段感情。\"\n                </p>\n                <section style=\"display: flex; justify-content: space-between; margin-top: 20px;\">\n                    <span style=\"font-size: 14px; color: #888; display: flex; align-items: center;\">\n                        <svg style=\"width: 16px; height: 16px; margin-right: 4px; fill: #888;\" viewBox=\"0 0 24 24\">\n                            <path\n                                d=\"M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z\">\n                            </path>\n                        </svg>\n                        28.5万\n                    </span>\n                    <span style=\"font-size: 14px; color: #888; display: flex; align-items: center;\">\n                        <svg style=\"width: 16px; height: 16px; margin-right: 4px; fill: #888;\" viewBox=\"0 0 24 24\">\n                            <path d=\"M21,6H3V5H21V6M18,11H6V10H18V11M15,17H9V16H15V17Z\"></path>\n                        </svg>\n                        热度指数: 9.8\n                    </span>\n                </section>\n            </section>\n        </section>\n\n        <!-- 热点新闻2 -->\n        <section\n            style=\"margin: 10px; padding: 25px; background-color: white; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.08);\">\n            <h2\n                style=\"margin: 0 0 15px 0; font-size: 22px; font-weight: 700; color: #222; border-bottom: 2px solid #f0f0f0; padding-bottom: 10px; line-height: 1.3;\">\n                综艺女王回归，片酬高达八千万？\n            </h2>\n            <p style=\"margin: 0 0 15px 0; font-size: 16px; line-height: 1.8; color: #555;\">\n                沉寂两年后，\"综艺女王\"林妙妙确认将在下个月回归荧屏，担任王牌综艺《潮流之夜》的常驻嘉宾。据行业内部人士透露，林妙妙此次回归的片酬高达八千万，创下综艺节目嘉宾新高。\n            </p>\n            <p style=\"margin: 0 0 15px 0; font-size: 16px; line-height: 1.8; color: #555;\">\n                林妙妙团队相关负责人对此回应：\"具体数字不便透露，但妙妙此次回归是经过深思熟虑的，更看重的是节目的创意和团队默契。\"然而，多位业内人士证实，除了惊人片酬外，林妙妙还获得了节目内容的部分决策权和个人品牌植入的特殊权益。\n            </p>\n            <section\n                style=\"margin: 20px 0; padding: 15px; background-color: #f9f9f9; border-radius: 10px; border-left: 4px solid #ff3366;\">\n                <p style=\"margin: 0; font-size: 15px; font-style: italic; color: #666;\">\n                    \"林妙妙的回归不仅仅是一次普通的复出，更是她重新定义个人品牌的战略举措。这一次，她将以全新的形象和态度面对观众。\" —— 娱乐评论家张力\n                </p>\n            </section>\n            <section style=\"display: flex; justify-content: space-between; margin-top: 20px;\">\n                <span style=\"font-size: 14px; color: #888;\">阅读量: 156.8万</span>\n                <span style=\"font-size: 14px; color: #ff3366; font-weight: 600;\">#林妙妙回归# 话题讨论中</span>\n            </section>\n        </section>\n\n        <!-- 动态内容区 -->\n        <section\n            style=\"margin: 10px; background-color: white; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.08); overflow: hidden;\">\n            <section style=\"padding: 20px; background: linear-gradient(to right, #3a7bd5, #00d2ff); color: white;\">\n                <h2 style=\"margin: 0; font-size: 20px; font-weight: 700; display: flex; align-items: center;\">\n                    <svg style=\"width: 24px; height: 24px; margin-right: 8px; fill: white;\" viewBox=\"0 0 24 24\">\n                        <path\n                            d=\"M16,6L16.83,9H20V12H18L19,15H16.83L15.83,12H8.17L7.17,15H5L6,12H4V9H7.17L8,6H10L9.17,9H14.83L14,6H16M10,9L10.83,6H13.17L12.33,9H10Z\">\n                        </path>\n                    </svg>\n                    热搜趋势\n                </h2>\n            </section>\n            <section style=\"padding: 5px 15px;\">\n                <section style=\"display: flex; padding: 15px 0; border-bottom: 1px solid #f0f0f0; align-items: center;\">\n                    <span style=\"font-size: 18px; font-weight: 700; color: #ff3366; margin-right: 15px;\">01</span>\n                    <section style=\"flex-grow: 1;\">\n                        <p style=\"margin: 0; font-size: 16px; font-weight: 600;\">陈赫新片票房破10亿</p>\n                        <p style=\"margin: 5px 0 0 0; font-size: 14px; color: #888;\">4982.5万讨论</p>\n                    </section>\n                    <span\n                        style=\"font-size: 14px; color: white; background-color: #ff3366; padding: 2px 8px; border-radius: 12px;\">热</span>\n                </section>\n\n                <section style=\"display: flex; padding: 15px 0; border-bottom: 1px solid #f0f0f0; align-items: center;\">\n                    <span style=\"font-size: 18px; font-weight: 700; color: #ff5e62; margin-right: 15px;\">02</span>\n                    <section style=\"flex-grow: 1;\">\n                        <p style=\"margin: 0; font-size: 16px; font-weight: 600;\">周杰伦新歌疑抄袭</p>\n                        <p style=\"margin: 5px 0 0 0; font-size: 14px; color: #888;\">3651.8万讨论</p>\n                    </section>\n                    <span\n                        style=\"font-size: 14px; color: white; background-color: #ff5e62; padding: 2px 8px; border-radius: 12px;\">新</span>\n                </section>\n\n                <section style=\"display: flex; padding: 15px 0; border-bottom: 1px solid #f0f0f0; align-items: center;\">\n                    <span style=\"font-size: 18px; font-weight: 700; color: #ff9966; margin-right: 15px;\">03</span>\n                    <section style=\"flex-grow: 1;\">\n                        <p style=\"margin: 0; font-size: 16px; font-weight: 600;\">王一博退出《这就是街舞》</p>\n                        <p style=\"margin: 5px 0 0 0; font-size: 14px; color: #888;\">2783.2万讨论</p>\n                    </section>\n                </section>\n\n                <section style=\"display: flex; padding: 15px 0; border-bottom: 1px solid #f0f0f0; align-items: center;\">\n                    <span style=\"font-size: 18px; font-weight: 700; color: #888; margin-right: 15px;\">04</span>\n                    <section style=\"flex-grow: 1;\">\n                        <p style=\"margin: 0; font-size: 16px; font-weight: 600;\">杨幂回应整容传闻</p>\n                        <p style=\"margin: 5px 0 0 0; font-size: 14px; color: #888;\">1932.7万讨论</p>\n                    </section>\n                </section>\n\n                <section style=\"display: flex; padding: 15px 0; align-items: center;\">\n                    <span style=\"font-size: 18px; font-weight: 700; color: #888; margin-right: 15px;\">05</span>\n                    <section style=\"flex-grow: 1;\">\n                        <p style=\"margin: 0; font-size: 16px; font-weight: 600;\">肖战新剧开机</p>\n                        <p style=\"margin: 5px 0 0 0; font-size: 14px; color: #888;\">1573.4万讨论</p>\n                    </section>\n                </section>\n            </section>\n        </section>\n\n        <!-- 深度报道 -->\n        <section\n            style=\"margin: 10px; padding: 25px; background-color: white; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.08);\">\n            <section style=\"display: flex; align-items: center; margin-bottom: 20px;\">\n                <section\n                    style=\"width: 8px; height: 28px; background-color: #ff3366; margin-right: 10px; border-radius: 4px;\">\n                </section>\n                <h2 style=\"margin: 0; font-size: 22px; font-weight: 700; color: #222;\">深度揭秘：爆款选秀节目背后的资本角力</h2>\n            </section>\n\n            <p style=\"margin: 0 0 15px 0; font-size: 16px; line-height: 1.8; color: #555; text-indent: 2em;\">\n                近年来，选秀节目在我国综艺市场大放异彩，《星光璀璨》、《追梦之声》等节目不仅创造了惊人的收视率和话题度，更催生了数十亿元规模的衍生产业链。然而，鲜为人知的是，这些看似以\"选拔人才\"为目的的节目背后，实则是各大资本集团的激烈博弈。\n            </p>\n\n            <p style=\"margin: 0 0 15px 0; font-size: 16px; line-height: 1.8; color: #555; text-indent: 2em;\">\n                据知情人士透露，今年即将开播的《明日之子2025》节目组已经提前半年开始接触各大经纪公司，为自家艺人争取有利位置。\"节目看似公平，实际上很多环节早已被安排好。不同背景的选手获得的资源差异巨大，从镜头时长、造型预算到歌曲选择权，都暗藏玄机。\"一位不愿透露姓名的选秀节目前制作人坦言。\n            </p>\n\n            <p style=\"margin: 0 0 15px 0; font-size: 16px; line-height: 1.8; color: #555; text-indent: 2em;\">\n                更令人咋舌的是，一些顶级选手在节目开播前就已经被分配好了出道位置，而节目过程只是为了给观众制造\"选秀\"的假象。\"有些选手的合约在节目开始前早已签好，包括出道后的商业代言、综艺排期都已经排满。\"业内人士称，这种现象在选秀节目中已经成为公开的秘密。\n            </p>\n\n            <section style=\"margin: 20px 0; height: 1px; background: linear-gradient(to right, #ff3366, transparent);\">\n            </section>\n\n            <p style=\"margin: 0 0 15px 0; font-size: 16px; line-height: 1.8; color: #555; text-indent: 2em;\">\n                近期，多位曾参加过选秀节目的选手也开始发声，揭露节目中的种种不公。前《追梦之声》选手小鱼（化名）告诉记者：\"很多观众以为的'成长'和'蜕变'都是节目组设计好的剧情。有选手故意被安排困难的歌曲，目的就是制造'逆袭'的戏剧效果。而有些选手无论表现多好，都会被剪辑成有争议的画面，为节目博取话题度。\"\n            </p>\n\n            <p style=\"margin: 0 0 15px 0; font-size: 16px; line-height: 1.8; color: #555; text-indent: 2em;\">\n                文化评论家赵明认为：\"选秀节目的商业化运作已经远远超出了发掘艺术人才的初衷。在巨额利益的驱动下，这些节目更像是一场精心设计的营销活动，而不是真正的才艺竞争。观众需要用更加理性的眼光看待这些节目，不要轻易被节目营造的情绪所左右。\"\n            </p>\n\n            <section style=\"margin-top: 20px; display: flex; justify-content: space-between; align-items: center;\">\n                <span style=\"font-size: 14px; color: #888;\">来源：娱乐内参</span>\n                <section style=\"display: flex; align-items: center;\">\n                    <svg style=\"width: 20px; height: 20px; fill: #ff3366; margin-right: 5px;\" viewBox=\"0 0 24 24\">\n                        <path\n                            d=\"M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z\">\n                        </path>\n                    </svg>\n                    <span style=\"font-size: 14px; color: #ff3366;\">收藏本文</span>\n                </section>\n            </section>\n        </section>\n\n        <!-- 互动区域 -->\n        <section\n            style=\"margin: 10px; padding: 25px 25px 10px 25px; background-color: white; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.08);\">\n            <h3 style=\"margin: 0 0 20px 0; font-size: 20px; font-weight: 700; color: #222; text-align: center;\">\n                <svg style=\"width: 24px; height: 24px; vertical-align: middle; margin-right: 8px; fill: #ff3366;\"\n                    viewBox=\"0 0 24 24\">\n                    <path\n                        d=\"M12,3C6.5,3 2,6.58 2,11C2.05,13.15 3.06,15.17 4.75,16.5C4.75,17.1 4.33,18.67 2,21C4.37,20.89 6.64,20 8.47,18.5C9.61,18.83 10.81,19 12,19C17.5,19 22,15.42 22,11C22,6.58 17.5,3 12,3M12,17C7.58,17 4,14.31 4,11C4,7.69 7.58,5 12,5C16.42,5 20,7.69 20,11C20,14.31 16.42,17 12,17Z\">\n                    </path>\n                </svg>\n                热门评论\n            </h3>\n\n            <section style=\"padding: 15px; margin-bottom: 15px; background-color: #f9f9f9; border-radius: 12px;\">\n                <section style=\"display: flex; align-items: center; margin-bottom: 10px;\">\n                    <section\n                        style=\"width: 40px; height: 40px; border-radius: 50%; background-color: #ff3366; color: white; display: flex; justify-content: center; align-items: center; font-weight: 700; margin-right: 10px;\">\n                        L</section>\n                    <section>\n                        <p style=\"margin: 0; font-size: 16px; font-weight: 600; color: #333;\">旧梦i</p>\n                        <p style=\"margin: 0; font-size: 12px; color: #888;\">2小时前</p>\n                    </section>\n                </section>\n                <p style=\"margin: 0; font-size: 15px; line-height: 1.6; color: #555;\">\n                    安潇和艾莉也太般配了吧！之前在《星河传说》里的化学反应就超强，希望这次是真的官宣，我磕的CP终于成真了！\n                </p>\n                <section style=\"display: flex; justify-content: space-between; margin-top: 10px;\">\n                    <span style=\"font-size: 13px; color: #888;\">3.2k 赞</span>\n                    <span style=\"font-size: 13px; color: #888;\">回复</span>\n                </section>\n            </section>\n\n            <section style=\"padding: 15px; margin-bottom: 15px; background-color: #f9f9f9; border-radius: 12px;\">\n                <section style=\"display: flex; align-items: center; margin-bottom: 10px;\">\n                    <section\n                        style=\"width: 40px; height: 40px; border-radius: 50%; background-color: #3a7bd5; color: white; display: flex; justify-content: center; align-items: center; font-weight: 700; margin-right: 10px;\">\n                        W</section>\n                    <section>\n                        <p style=\"margin: 0; font-size: 16px; font-weight: 600; color: #333;\">娱乐圈观察员</p>\n                        <p style=\"margin: 0; font-size: 12px; color: #888;\">5小时前</p>\n                    </section>\n                </section>\n                <p style=\"margin: 0; font-size: 15px; line-height: 1.6; color: #555;\">\n                    选秀节目的乱象早该被揭露了！作为业内人士，我可以证实文中说的大部分内容都是真实的。观众们被骗了这么多年，该醒醒了。这些节目根本不是在选拔人才，而是在制造流量密码。\n                </p>\n                <section style=\"display: flex; justify-content: space-between; margin-top: 10px;\">\n                    <span style=\"font-size: 13px; color: #888;\">2.7k 赞</span>\n                    <span style=\"font-size: 13px; color: #888;\">回复</span>\n                </section>\n            </section>\n\n        </section>\n\n        <!-- 相关推荐 -->\n        <section\n            style=\"margin: 10px; padding: 0; background-color: white; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.08); overflow: hidden;\">\n            <section style=\"padding: 15px 20px; background: linear-gradient(to right, #ff3366, #ff5e62); color: white;\">\n                <h3 style=\"margin: 0; font-size: 18px; font-weight: 700;\">\n                    <svg style=\"width: 20px; height: 20px; vertical-align: middle; margin-right: 8px; fill: white;\"\n                        viewBox=\"0 0 24 24\">\n                        <path d=\"M4,5H20V7H4V5M4,9H20V11H4V9M4,13H20V15H4V13M4,17H20V19H4V17Z\"></path>\n                    </svg>\n                    猜你喜欢\n                </h3>\n            </section>\n            <section style=\"padding: 15px;\">\n                <section style=\"display: flex; padding: 10px 0; border-bottom: 1px solid #f0f0f0;\">\n                    <section style=\"width: 80px; height: 80px; border-radius: 8px; margin-right: 15px; flex-shrink: 0;\">\n                        <img src=\"https://picsum.photos/200/200?random=2\" alt=\"推荐图片1\"\n                            style=\"width: 80px; height: 80px; object-fit: cover; border-radius: 8px; display: block;\">\n                    </section>\n                    <section style=\"flex-grow: 1;\">\n                        <p style=\"margin: 0 0 8px 0; font-size: 16px; font-weight: 600; color: #333; line-height: 1.4;\">\n                            张艺谋新片《长城秘闻》开机，主演阵容引爆期待\n                        </p>\n                        <p style=\"margin: 0; font-size: 14px; color: #888;\">12.8万阅读 · 2小时前</p>\n                    </section>\n                </section>\n                <section style=\"display: flex; padding: 10px 0; border-bottom: 1px solid #f0f0f0;\">\n                    <section style=\"width: 80px; height: 80px; border-radius: 8px; margin-right: 15px; flex-shrink: 0;\">\n                        <img src=\"https://picsum.photos/200/200?random=3\" alt=\"推荐图片2\"\n                            style=\"width: 80px; height: 80px; object-fit: cover; border-radius: 8px; display: block;\">\n                    </section>\n                    <section style=\"flex-grow: 1;\">\n                        <p style=\"margin: 0 0 8px 0; font-size: 16px; font-weight: 600; color: #333; line-height: 1.4;\">\n                            独家！刘德华确认加盟《英雄3》，与李连杰时隔20年再合作\n                        </p>\n                        <p style=\"margin: 0; font-size: 14px; color: #888;\">9.5万阅读 · 5小时前</p>\n                    </section>\n                </section>\n                <section style=\"display: flex; padding: 10px 0;\">\n                    <section style=\"width: 80px; height: 80px; border-radius: 8px; margin-right: 15px; flex-shrink: 0;\">\n                        <img src=\"https://picsum.photos/200/200?random=4\" alt=\"推荐图片3\"\n                            style=\"width: 80px; height: 80px; object-fit: cover; border-radius: 8px; display: block;\">\n                    </section>\n                    <section style=\"flex-grow: 1;\">\n                        <p style=\"margin: 0 0 8px 0; font-size: 16px; font-weight: 600; color: #333; line-height: 1.4;\">\n                            赵丽颖产后复出首秀，新剧收视率创年度新高\n                        </p>\n                        <p style=\"margin: 0; font-size: 14px; color: #888;\">8.3万阅读 · 1天前</p>\n                    </section>\n                </section>\n            </section>\n        </section>\n\n</body>\n\n</html>"
  },
  "html": "<section style=\"box-sizing: border-box\" id=\"cw-layout-imported\"><section style=\"background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%); box-sizing: border-box; color: #333; font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif; line-height: 1.6; margin: 0; max-width: 100%; padding: 0\"><section style=\"background: linear-gradient(135deg, #c61f50 0%, #bd3b42 100%); border: 1px solid rgba(0,0,0,0.08); border-radius: 0 0 25px 25px; box-sizing: border-box; color: white; margin: 0; padding: 10px\"><p style=\"box-sizing: border-box; display: block; margin-top: 0px; overflow-wrap: anywhere; text-indent: 0px;\">文章的第一眼，决定读者愿不愿意停下来。好排版让观点先被看见，再让细节慢慢展开。</p></section><section><p style=\"box-sizing: border-box; display: block; font-size: 16px; font-weight: 600; height: auto; line-height: 1.8; margin: 0; max-width: 100%; width: 100%\"><img src=\"https://images.unsplash.com/photo-1499951360447-b19be8fe80f5?auto=format&fit=crop&w=1200&q=85\" alt=\"桌面上的阅读与写作\" style=\"display: block; height: auto; margin: 16px 0; max-width: 100%; width: 100%\"></p></section><section style=\"background-color: white; border: 1px solid rgba(0,0,0,0.08); border-radius: 15px; box-sizing: border-box; display: block; margin: 10px; padding: 0\"><section style=\"box-sizing: border-box; padding: 20px; width: 100%\"><h2 style=\"box-sizing: border-box; color: #222; font-size: 22px; font-weight: 700; line-height: 1.3; margin: 0 0 15px 0; overflow-wrap: anywhere; text-indent: 0\">从标题开始，建立阅读节奏</h2><section><p style=\"box-sizing: border-box; color: #555; font-size: 16px; font-weight: 600; line-height: 1.8; margin: 0 0 15px 0\">标题需要一个清楚的重心。<strong>重点句只强调一次</strong>，其余正文让段落长度、行距和留白承担节奏。</p></section><section><blockquote style=\"border: 0; border-left: 0; margin: 0; padding: 0\"><p style=\"box-sizing: border-box; color: #666; font-size: 15px; font-style: italic; font-weight: 600; line-height: 1.8; margin: 0\">排版的任务，是把内容的关系呈现出来。</p></blockquote></section><section><p style=\"box-sizing: border-box; color: #555; font-size: 16px; font-weight: 600; line-height: 1.8; margin: 0 0 15px 0\">每种风格都应该有自己的声音，同时让正文保持完整、清楚和可读。</p></section></section></section><section style=\"background-color: white; border: 1px solid rgba(0,0,0,0.08); border-radius: 15px; box-sizing: border-box; margin: 10px; padding: 25px\"><h2 style=\"border-bottom: 2px solid #f0f0f0; box-sizing: border-box; color: #222; font-size: 22px; font-weight: 700; line-height: 1.3; margin: 0 0 15px 0; overflow-wrap: anywhere; padding-bottom: 10px; text-indent: 0\">三个可以马上检查的地方</h2><section><ul style=\"color: #555\"><li>标题是否有独立的视觉重心</li><li>章节之间是否留出呼吸空间</li><li>重点是否与普通正文形成清楚层级</li></ul></section><section><p style=\"box-sizing: border-box; display: block; font-size: 16px; font-weight: 600; height: auto; line-height: 1.8; margin: 0; max-width: 100%; width: 100%\"><img src=\"https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=1200&q=85\" alt=\"写作中的页面\" style=\"display: block; height: auto; margin: 16px 0; max-width: 100%; width: 100%\"></p></section><section><p style=\"box-sizing: border-box; display: block; font-size: 16px; font-weight: 600; height: auto; line-height: 1.8; margin: 0; max-width: 100%; width: 100%\"><img src=\"https://images.unsplash.com/photo-1515378791036-0648a3ef77b2?auto=format&fit=crop&w=1200&q=85\" alt=\"工作台上的笔记\" style=\"display: block; height: auto; margin: 16px 0; max-width: 100%; width: 100%\"></p></section><section><table style=\"border-collapse: collapse; color: #555; margin: 18px 0; table-layout: fixed; width: 100%\"><thead><tr><th style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">检查项</th><th style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">观察方式</th></tr></thead><tbody><tr><td style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">标题</td><td style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">第一眼能否找到主题</td></tr><tr><td style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">正文</td><td style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">是否能够连续阅读</td></tr><tr><td style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">引用</td><td style=\"border: 1px solid #d8dee5; overflow-wrap: anywhere; padding: 8px\">是否与作者叙述区分</td></tr></tbody></table></section><section><p style=\"box-sizing: border-box; display: block; font-size: 16px; font-weight: 600; height: auto; line-height: 1.8; margin: 0; max-width: 100%; width: 100%\"><img src=\"https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=1200&q=85\" alt=\"打开的杂志与页面\" style=\"display: block; height: auto; margin: 16px 0; max-width: 100%; width: 100%\"></p></section></section><section style=\"background-color: white; border: 1px solid rgba(0,0,0,0.08); border-radius: 15px; box-sizing: border-box; margin: 10px\"><section style=\"background: linear-gradient(to right, #3a7bd5, #00d2ff); box-sizing: border-box; color: white; padding: 20px\"><h2 style=\"box-sizing: border-box; display: block; font-size: 20px; font-weight: 700; margin: 0; overflow-wrap: anywhere; text-indent: 0\">把风格落实到每一个细节</h2></section><section style=\"box-sizing: border-box; padding: 5px 15px\"><section style=\"border-bottom: 1px solid #f0f0f0; box-sizing: border-box; display: block; padding: 15px 0\"><section style=\"box-sizing: border-box; width: 100%\"><p style=\"box-sizing: border-box; color: #333; font-size: 16px; font-weight: 600; line-height: 1.8; margin: 0\">报纸用硬边栏线建立秩序，杂志用大留白放慢速度，信笺让段落像一次自然的交谈。</p></section></section><section><p style=\"box-sizing: border-box; display: block; font-size: 16px; font-weight: 600; height: auto; line-height: 1.8; margin: 0; max-width: 100%; width: 100%\"><img src=\"https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&fit=crop&w=1200&q=85\" alt=\"阅读中的书页\" style=\"display: block; height: auto; margin: 16px 0; max-width: 100%; width: 100%\"></p></section><section style=\"border-bottom: 1px solid #f0f0f0; box-sizing: border-box; display: block; padding: 15px 0\"><section style=\"box-sizing: border-box; width: 100%\"><p style=\"box-sizing: border-box; color: #333; font-size: 16px; font-weight: 600; line-height: 1.8; margin: 0\">一个完整的句子，不应该为了装饰被删掉。一张原有的表格，也不应该被换成没有事实来源的数字。</p></section></section><section style=\"border-bottom: 1px solid #f0f0f0; box-sizing: border-box; display: block; padding: 15px 0\"><section style=\"box-sizing: border-box; width: 100%\"><p style=\"box-sizing: border-box; color: #333; font-size: 16px; font-weight: 600; line-height: 1.8; margin: 0\">读完之后，留下一个清楚的观点，比留下许多重复的色块更有价值。</p></section></section></section></section></section></section>",
  "layoutPrompt": "[cw-imported-style:{\"root\":\"box-sizing: border-box\",\"elements\":{\"blockquote\":\"border-left:3px solid #94a3b8;padding:12px 16px;margin:18px 0\",\"img\":\"display:block;width:100%;max-width:100%;height:auto;margin:16px 0\",\"p\":\"box-sizing: border-box; font-size: 16px; font-weight: 600; line-height: 1.8; margin: 0\",\"table\":\"width:100%;border-collapse:collapse;table-layout:fixed;margin:18px 0\",\"td\":\"border:1px solid #d8dee5;padding:8px;overflow-wrap:anywhere\",\"th\":\"border:1px solid #d8dee5;padding:8px;overflow-wrap:anywhere\"},\"structure\":{\"version\":2,\"frame\":\"<section style=\\\"box-sizing: border-box\\\"><section style=\\\"background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%); box-sizing: border-box; color: #333; font-family: &#39;PingFang SC&#39;, &#39;Hiragino Sans GB&#39;, &#39;Microsoft YaHei&#39;, sans-serif; line-height: 1.6; margin: 0; max-width: 100%; padding: 0\\\"><section style=\\\"background: linear-gradient(135deg, #c61f50 0%, #bd3b42 100%); border: 1px solid rgba(0,0,0,0.08); border-radius: 0 0 25px 25px; box-sizing: border-box; color: white; margin: 0; padding: 10px\\\"><h1 style=\\\"box-sizing: border-box; font-size: 28px; font-weight: 900; letter-spacing: 1px; margin: 0; overflow-wrap: anywhere; padding: 10px 0; text-align: center; text-indent: 0\\\">{{title}}</h1><p style=\\\"box-sizing: border-box; display: block; margin-top: 10px; overflow-wrap: anywhere; text-indent: 0\\\">{{subtitle}}</p></section>{{body}}</section></section>\",\"headerLead\":true,\"lead\":{\"frame\":\"<section style=\\\"background-color: white; border: 1px solid rgba(0,0,0,0.08); border-radius: 15px; box-sizing: border-box; margin: 10px; padding: 25px\\\">{{content}}</section>\",\"style\":\"border-left: 4px solid #c61f50; box-sizing: border-box; color: #333; font-size: 18px; font-weight: 600; line-height: 1.4; margin: 0 0 15px 0; padding-left: 15px\"},\"sections\":{\"2\":[{\"frame\":\"<section style=\\\"background-color: wh