\"padding\":\"0 0 12px\",\"margin\":\"0 0 16px\",\"line-height\":\"1.5\",\"font-size\":\"21px\",\"font-weight\":\"700\"},\"quote\":{\"margin\":\"24px 0\",\"line-height\":\"1.85\",\"color\":\"#353d36\",\"font-size\":\"17px\",\"border\":\"1px dashed #62705f\",\"padding\":\"18px\",\"background-color\":\"#dedecb\"},\"ending\":{\"font-size\":\"16px\",\"color\":\"#353d36\",\"line-height\":\"1.95\",\"margin\":\"32px 0 0\",\"border\":\"0\",\"border-top\":\"1px solid #62705f\",\"padding\":\"18px 0 0\"},\"image\":{\"margin\":\"24px 0\"},\"table\":{\"font-size\":\"15px\",\"line-height\":\"1.7\"}},\"chapters\":[{\"display\":\"table\",\"table-layout\":\"fixed\",\"width\":\"100%\",\"padding\":\"20px 0\",\"margin\":\"28px 0 0\",\"border\":\"0\",\"border-top\":\"1px solid #4b614b\",\"background\":\"transparent\"}],\"headingSurface\":{\"display\":\"table-cell\",\"width\":\"30%\",\"vertical-align\":\"top\",\"padding\":\"0 16px 0 0\"},\"bodySurface\":{\"display\":\"table-cell\",\"width\":\"70%\",\"vertical-align\":\"top\",\"padding-left\":\"18px\",\"border-left\":\"1px solid #62705f\"},\"initial\":{}},\"blocks\":[]}]",
