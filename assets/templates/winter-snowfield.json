heading\":{\"display\":\"block\",\"width\":\"auto\",\"color\":\"#35465b\",\"background\":\"transparent\",\"border\":\"0\",\"padding\":\"0\",\"margin\":\"0 0 16px\",\"line-height\":\"1.5\",\"font-size\":\"22px\",\"font-weight\":\"500\",\"text-align\":\"center\",\"border-bottom\":\"1px solid #e1eaf3\",\"padding-bottom\":\"16px\"},\"quote\":{\"margin\":\"24px 0\",\"line-height\":\"1.85\",\"color\":\"#35465b\",\"font-size\":\"20px\",\"text-align\":\"center\",\"border\":\"1px solid #657891\",\"border-radius\":\"20px\",\"padding\":\"24px 18px\",\"background\":\"transparent\"},\"ending\":{\"font-size\":\"16px\",\"color\":\"#35465b\",\"line-height\":\"1.95\",\"margin\":\"32px 0 0\",\"border\":\"0\",\"border-top\":\"1px solid #657891\",\"padding\":\"18px 0 0\"},\"image\":{\"margin\":\"24px 0\"},\"table\":{\"font-size\":\"15px\",\"line-height\":\"1.7\"}},\"chapters\":[{\"width\":\"90%\",\"margin\":\"38px auto 0\",\"padding\":\"16px 0\",\"border\":\"0\",\"background\":\"transparent\"}],\"headingSurface\":{},\"bodySurface\":{},\"initial\":{}},\"blocks\":[]}]",
