  "schemaVersion": 1,
  "id": "aiwritex-html-e00f36e1c367",
  "type": "html-template",
  "original": {
    "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n\n<body\n  style=\"margin: 0; padding: 0; font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif; color: #333; background-color: #f8f9fa; line-height: 1.6;\">\n\n  <section\n    style=\"padding: 0; margin: 0; background: linear-gradient(135deg, #1a6fc4 0%, #2e8ae6 100%); color: white; position: relative; overflow: hidden;\">\n    <section style=\"padding: 25px 20px 70px;\">\n      <h1 style=\"margin: 0; font-size: 28px; font-weight: 800; letter-spacing: 1px; line-height: 1.3;\">\n        人民日报观察：杭州一干部送外卖60天，调研骑手切实需求</h1>\n      <section style=\"display: flex; align-items: center; margin-top: 15px;\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" style=\"fill: white; margin-right: 8px;\">\n          <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z\" />\n        </svg>\n        <span style=\"font-size: 14px; opacity: 0.9;\">EXCLUSIVE REPORT · 2025年6月</span>\n      </section>\n    </section>\n    <svg width=\"100%\" height=\"40\" viewBox=\"0 0 1440 48\" style=\"position: relative; bottom: 0; left: 0;\">\n      <path d=\"M0,0 C320,48 420,48 720,24 C1020,0 1120,0 1440,48 L1440,48 L0,48 Z\" fill=\"white\"></path>\n    </svg>\n  </section>\n\n  <section\n    style=\"margin: -30px 16px 24px; padding: 25px 20px; background: white; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);\">\n    <section style=\"display: flex; align-items: center; margin-bottom: 20px;\">\n      <section\n        style=\"width: 40px; height: 40px; border-radius: 50%; background: #f0f7ff; display: flex; justify-content: center; align-items: center; margin-right: 15px;\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" style=\"fill: #1a6fc4;\">\n          <path\n            d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z\" />\n        </svg>\n      </section>\n      <h2 style=\"margin: 0; font-size: 20px; font-weight: 700; color: #1a6fc4;\">事件背景</h2>\n    </section>\n    <p style=\"margin: 0; font-size: 16px; line-height: 1.7; color: #4a4a4a;\">2025年6月，杭州市某基层干部<span\n        style=\"font-weight: 600; color: #333;\">李文星同志</span>以骑手身份全职工作60天，通过\"沉浸式调研\"深入体验外卖骑手工作日常。这一创新举措旨在突破传统调研模式，真实记录骑手面临的工作强度、平台规则及生存压力，为政策制定获取第一手资料。\n    </p>\n  </section>\n\n  <section\n    style=\"margin: 0 16px 24px; padding: 25px 20px; background: white; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);\">\n    <section style=\"display: flex; align-items: center; margin-bottom: 20px;\">\n      <section\n        style=\"width: 40px; height: 40px; border-radius: 50%; background: #fff0f0; display: flex; justify-content: center; align-items: center; margin-right: 15px;\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" style=\"fill: #e53935;\">\n          <path\n            d=\"M13.5,5.5c1.1,0,2-0.9,2-2s-0.9-2-2-2s-2,0.9-2,2S12.4,5.5,13.5,5.5z M20,12.5V23h-2v-7H6v7H4V12.5C4,11.1,5.1,10,6.5,10 h11C18.9,10,20,11.1,20,12.5z M16.1,7.1c-0.6-0.3-1.3,0.1-1.6,0.7L12,14.2l-1.4-1.4c-0.3-0.3-0.7-0.3-1,0l-0.9,0.9 c-0.3,0.3-0.3,0.7,0,1l2.8,2.8c0.4,0.4,1.1,0.3,1.3-0.2l3.3-8.1C16.4,8.4,16.6,7.4,16.1,7.1z\" />\n        </svg>\n      </section>\n      <h2 style=\"margin: 0; font-size: 20px; font-weight: 700; color: #e53935;\">核心调研发现</h2>\n    </section>\n\n    <section style=\"border-left: 3px solid #e53935; padding-left: 15px; margin: 20px 0;\">\n      <h3 style=\"margin: 0 0 10px; font-size: 17px; font-weight: 600; color: #333;\">工作强度与收入失衡</h3>\n      <p style=\"margin: 0 0 15px; font-size: 15px; color: #4a4a4a; line-height: 1.6;\">日均工作时长超<span\n          style=\"font-weight: 700; color: #e53935;\">12小时</span>，月收入完全依赖平台算法调度，超时罚款高达订单收入的<span\n          style=\"font-weight: 700; color: #e53935;\">50%</span></p>\n    </section>\n\n    <section style=\"border-left: 3px solid #e53935; padding-left: 15px; margin: 20px 0;\">\n      <h3 style=\"margin: 0 0 10px; font-size: 17px; font-weight: 600; color: #333;\">劳动保障缺失</h3>\n      <p style=\"margin: 0 0 15px; font-size: 15px; color: #4a4a4a; line-height: 1.6;\">抽样显示仅<span\n          style=\"font-weight: 700; color: #e53935;\">23%</span>骑手有工伤保险，<span\n          style=\"font-weight: 700; color: #e53935;\">76%</span>受访者遭遇过交通事故却无医疗保障</p>\n    </section>\n\n    <section style=\"border-left: 3px solid #e53935; padding-left: 15px; margin: 20px 0;\">\n      <h3 style=\"margin: 0 0 10px; font-size: 17px; font-weight: 600; color: #333;\">平台管理矛盾</h3>\n      <p style=\"margin: 0 0 15px; font-size: 15px; color: #4a4a4a; line-height: 1.6;\">用户评价体系存在\"差评连锁反应\"，1个差评需<span\n          style=\"font-weight: 700; color: #e53935;\">15个五星好评</span>才能抵消</p>\n    </section>\n  </section>\n\n  <section\n    style=\"margin: 0 16px 24px; background: white; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;\">\n    <section\n      style=\"height: 180px; background: url('https://picsum.photos/800/400?random=1') center center / cover no-repeat;\">\n    </section>\n    <section style=\"padding: 25px 20px;\">\n      <section style=\"display: flex; align-items: center; margin-bottom: 20px;\">\n        <section\n          style=\"width: 40px; height: 40px; border-radius: 50%; background: #e6f7f2; display: flex; justify-content: center; align-items: center; margin-right: 15px;\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" style=\"fill: #00897b;\">\n            <path\n              d=\"M12 3L1 9l4 2.18v6L12 21l7-3.82v-6l2-1.09V17h2V9L12 3zm6.82 6L12 12.72 5.18 9 12 5.28 18.82 9zM17 15.99l-5 2.73-5-2.73v-3.72L12 15l5-2.73v3.72z\" />\n          </svg>\n        </section>\n        <h2 style=\"margin: 0; font-size: 20px; font-weight: 700; color: #00897b;\">干部体验的深层意义</h2>\n      </section>\n\n      <section style=\"display: flex; margin-bottom: 15px; align-items: flex-start;\">\n        <section\n          style=\"width: 24px; height: 24px; border-radius: 50%; background: #00897b; color: white; font-size: 14px; display: flex; justify-content: center; align-items: center; margin-right: 12px; margin-top: 2px; flex-shrink: 0;\">\n          1</section>\n        <section>\n          <h3 style=\"margin: 0 0 5px; font-size: 16px; font-weight: 600; color: #333;\">执政理念突破</h3>\n          <p style=\"margin: 0; font-size: 15px; color: #4a4a4a; line-height: 1.6;\">将\"坐等汇报\"转为\"主动卧底\"，开创干部调研新范式</p>\n        </section>\n      </section>\n\n      <section style=\"display: flex; margin-bottom: 15px; align-items: flex-start;\">\n        <section\n          style=\"width: 24px; height: 24px; border-radius: 50%; background: #00897b; color: white; font-size: 14px; display: flex; justify-content: center; align-items: center; margin-right: 12px; margin-top: 2px; flex-shrink: 0;\">\n          2</section>\n        <section>\n          <h3 style=\"margin: 0 0 5px; font-size: 16px; font-weight: 600; color: #333;\">政策破局价值</h3>\n          <p style=\"margin: 0; font-size: 15px; color: #4a4a4a; line-height: 1.6;\">发现算法定价存在\"隐形剥削\"，促成杭州市启动平台经济算法审计</p>\n        </section>\n      </section>\n\n      <section style=\"display: flex; align-items: flex-start;\">\n        <section\n          style=\"width: 24px; height: 24px; border-radius: 50%; background: #00897b; color: white; font-size: 14px; display: flex; justify-content: center; align-items: center; margin-right: 12px; margin-top: 2px; flex-shrink: 0;\">\n          3</section>\n        <section>\n          <h3 style=\"margin: 0 0 5px; font-size: 16px; font-weight: 600; color: #333;\">认知重塑效应</h3>\n          <p style=\"margin: 0; font-size: 15px; color: #4a4a4a; line-height: 1.6;\">干部亲历零工群体\"抢单焦虑\"，推动制定心理疏导专项预案</p>\n        </section>\n      </section>\n    </section>\n  </section>\n\n  <section\n    style=\"margin: 0 16px 24px; padding: 25px 20px; background: white; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);\">\n    <section style=\"display: flex; align-items: center; margin-bottom: 20px;\">\n      <section\n        style=\"width: 40px; height: 40px; border-radius: 50%; background: #ede7f6; display: flex; justify-content: center; align-items: center; margin-right: 15px;\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" style=\"fill: #5e35b1;\">\n          <path\n            d=\"M18,8h-1V6c0-2.76-2.24-5-5-5S7,3.24,7,6v2H6c-1.1,0-2,0.9-2,2v10c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V10 C20,8.9,19.1,8,18,8z M9,6c0-1.66,1.34-3,3-3s3,1.34,3,3v2H9V6z M18,20H6V10h12V20z M12,17c1.1,0,2-0.9,2-2c0-1.1-0.9-2-2-2 c-1.1,0-2,0.9-2,2C10,16.1,10.9,17,12,17z\" />\n        </svg>\n      </section>\n      <h2 style=\"margin: 0; font-size: 20px; font-weight: 700; color: #5e35b1;\">行业痛点与政策启发</h2>\n    </section>\n\n    <section style=\"background: #f6f3fb; border-radius: 8px; padding: 15px; margin-bottom: 20px;\">\n      <h3 style=\"margin: 0 0 10px; font-size: 17px; font-weight: 600; color: #5e35b1;\">改革切入点</h3>\n      <ul style=\"margin: 0; padding: 0 0 0 20px; list-style-type: circle;\">\n        <li style=\"margin-bottom: 8px; font-size: 15px; color: #4a4a4a;\">全国首个\"算法透明化\"地方法规草案成形，强制公开配送定价参数</li>\n        <li style=\"font-size: 15px; color: #4a4a4a;\">试点\"骑手驿站\"提供无偿法律咨询和职业培训</li>\n      </ul>\n    </section>\n\n    <section style=\"background: #f6f3fb; border-radius: 8px; padding: 15px;\">\n      <h3 style=\"margin: 0 0 10px; font-size: 17px; font-weight: 600; color: #5e35b1;\">制度创新建议</h3>\n      <ul style=\"margin: 0; padding: 0 0 0 20px; list-style-type: circle;\">\n        <li style=\"margin-bottom: 8px; font-size: 15px; color: #4a4a4a;\">建立接单量分级保险制度，保费由平台按订单比例缴纳</li>\n        <li style=\"font-size: 15px; color: #4a4a4a;\">设立即时申诉通道，48小时内处理骑手争议订单</li>\n      </ul>\n    </section>\n  </section>\n\n  <section\n    style=\"margin: 0 16px 24px; padding: 0; background: white; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;\">\n    <section style=\"background: linear-gradient(135deg, #5e35b1 0%, #7e57c2 100%); padding: 20px; color: white;\">\n      <section style=\"display: flex; align-items: center; margin-bottom: 15px;\">\n        <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" style=\"fill: white; margin-right: 10px;\">\n          <path d=\"M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6h-6z\" />\n        </svg>\n        <h2 style=\"margin: 0; font-size: 20px; font-weight: 700;\">社会反响与未来展望</h2>\n      </section>\n      <p style=\"margin: 0; font-size: 14px; opacity: 0.9; font-weight: 300;\">DATA INSIGHTS</p>\n    </section>\n\n    <section style=\"padding: 20px;\">\n      <section style=\"display: flex; align-items: center; margin-bottom: 15px;\">\n        <section\n          style=\"width: 50px; height: 50px; border-radius: 50%; background: #ede7f6; display: flex; justify-content: center; align-items: center; margin-right: 15px; flex-shrink: 0;\">\n          <svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" style=\"fill: #5e35b1;\">\n            <path\n              d=\"M23 8c0 1.1-.9 2-2 2-.18 0-.35-.02-.51-.07l-3.56 3.55c.05.16.07.34.07.52 0 1.1-.9 2-2 2s-2-.9-2-2c0-.18.02-.36.07-.52l-2.55-2.55c-.16.05-.34.07-.52.07s-.36-.02-.52-.07l-4.55 4.56c.05.16.07.33.07.51 0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2c.18 0 .35.02.51.07l4.56-4.55C8.02 9.36 8 9.18 8 9c0-1.1.9-2 2-2s2 .9 2 2c0 .18-.02.36-.07.52l2.55 2.55c.16-.05.34-.07.52-.07s.36.02.52.07l3.55-3.56C19.02 8.35 19 8.18 19 8c0-1.1.9-2 2-2s2 .9 2 2z\" />\n          </svg>\n        </section>\n        <section>\n          <h3 style=\"margin: 0 0 5px; font-size: 16px; font-weight: 600; color: #333;\">舆论热议</h3>\n          <p style=\"margin: 0; font-size: 15px; color: #4a4a4a; line-height: 1.6;\"><span\n              style=\"font-weight: 600; color: #5e35b1;\">#干部体验送外卖#</span>话题阅读量破<span\n              style=\"font-weight: 600; color: #5e35b1;\">3.8亿</span>，73%网友支持推广该模式</p>\n        </section>\n      </section>\n\n      <section style=\"display: flex; align-items: center; margin-bottom: 15px;\">\n        <section\n          style=\"width: 50px; height: 50px; border-radius: 50%; background: #ede7f6; display: flex; justify-content: center; align-items: center; margin-right: 15px; flex-shrink: 0;\">\n          <svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" style=\"fill: #5e35b1;\">\n            <path\n              d=\"M19 3h-4.18C14.4 1.84 13.3 1 12 1c-1.3 0-2.4.84-2.82 2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 0c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm-2 14l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z\" />\n          </svg>\n        </section>\n        <section>\n          <h3 style=\"margin: 0 0 5px; font-size: 16px; font-weight: 600; color: #333;\">长效化机制</h3>\n          <p style=\"margin: 0; font-size: 15px; color: #4a4a4a; line-height: 1.6;\">杭州市将\"岗位体验\"纳入干部考核，要求处级干部每年至少体验<span\n              style=\"font-weight: 600; color: #5e35b1;\">1周</span>基层岗位</p>\n        </section>\n      </section>\n\n      <section style=\"display: flex; align-items: center;\">\n        <section\n          style=\"width: 50px; height: 50px; border-radius: 50%; background: #ede7f6; display: flex; justify-content: center; align-items: center; margin-right: 15px; flex-shrink: 0;\">\n          <svg width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" style=\"fill: #5e35b1;\">\n            <path\n              d=\"M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1zm-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1z\" />\n          </svg>\n        </section>\n        <section>\n          <h3 style=\"margin: 0 0 5px; font-size: 16px; font-weight: 600; color: #333;\">行业影响</h3>\n          <p style=\"margin: 0; font-size: 15px; color: #4a4a4a; line-height: 1.6;\">引发美团、饿了么等平台修订骑手保障条款，新增<span\n              style=\"font-weight: 600; color: #5e35b1;\">极端天气熔断机制</span></p>\n        </section>\n      </section>\n    </section>\n  </section>\n\n  <section\n    style=\"margin: 0 16px 24px; padding: 20px; background: #f3f4f5; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);\">\n    <p style=\"margin: 0; font-size: 14px; color: #6b7280; line-height: 1.7; font-style: italic; text-align: center;\">\n      本文数据截至2025年6月，所有调研结果均摘自杭州市政府《新就业形态劳动者权益保障白皮书》</p>\n  </section>\n\n</body>\n\n</html>"
  },
  "html": "<section style=\"padding: 24px; color: #292b2e; background-color: #fff\"><h1 style=\"margin: 0; font-size: 28px; font-weight: 800; letter-spacing: 1px; line-height: 1.3\">把阅读变成一次舒服的停留</h1><section><p style=\"margin: 0; font-size: 16px; line-height: 1.7; color: #4a4a4a\">文章的第一眼，决定读者愿不愿意停下来。好排版让观点先被看见，再让细节慢慢展开。</p><p style=\"margin: 0; font-size: 16px; line-height: 1.7; color: #4a4a4a\"><img src=\"https://images.unsplash.com/photo-1499951360447-b19be8fe80f5?auto=format&amp;fit=crop&amp;w=1200&amp;q=85\" alt=\"桌面上的阅读与写作\"/></p><h2 style=\"margin: 0; font-size: 20px; font-weight: 700; color: #1a6fc4\">从标题开始，建立阅读节奏</h2><p style=\"margin: 0; font-size: 16px; line-height: 1.7; color: #4a4a4a\">标题需要一个清楚的重心。<strong>重点句只强调一次</strong>，其余正文让段落长度、行距和留白承担节奏。</p><blockquote><p style=\"margin: 0; font-size: 16px; line-height: 1.7; color: #4a4a4a\">排版的任务，是把内容的关系呈现出来。</p></blockquote><p style=\"margin: 0; font-size: 16px; line-height: 1.7; color: #4a4a4a\">每种风格都应该有自己的声音，同时让正文保持完整、清楚和可读。</p><h2 style=\"margin: 0; font-size: 20px; font-weight: 700; color: #1a6fc4\">三个可以马上检查的地方</h2><ul style=\"margin: 0; padding: 0 0 0 20px; list-style-type: circle\"><li style=\"margin-bottom: 8px; font-size: 15px; color: #4a4a4a\">标题是否有独立的视觉重心</li><li style=\"margin-bottom: 8px; font-size: 15px; color: #4a4a4a\">章节之间是否留出呼吸空间</li><li style=\"margin-bottom: 8px; font-size: 15px; color: #4a4a4a\">重点是否与普通正文形成清楚层级</li></ul><p style=\"margin: 0; font-size: 16px; line-height: 1.7; color: #4a4a4a\"><img src=\"https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&amp;fit=crop&amp;w=1200&amp;q=85\" alt=\"写作中的页面\"/></p><p style=\"margin: 0; font-size: 16px; line-height: 1.7; color: #4a4a4a\"><img src=\"https://images.unsplash.com/photo-1515378791036-0648a3ef77b2?auto=format&amp;fit=crop&amp;w=1200&amp;q=85\" alt=\"工作台上的笔记\"/></p><table><thead><tr><th>检查项</th><th>观察方式</th></tr></thead><tbody><tr><td>标题</td><td>第一眼能否找到主题</td></tr><tr><td>正文</td><td>是否能够连续阅读</td></tr><tr><td>引用</td><td>是否与作者叙述区分</td></tr></tbody></table><p style=\"margin: 0; font-size: 16px; line-height: 1.7; color: #4a4a4a\"><img src=\"https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&amp;fit=crop&amp;w=1200&amp;q=85\" alt=\"打开的杂志与页面\"/></p><h2 style=\"margin: 0; font-size: 20px; font-weight: 700; color: #1a6fc4\">把风格落实到每一个细节</h2><p style=\"margin: 0; font-size: 16px; line-height: 1.7; color: #4a4a4a\">报纸用硬边栏线建立秩序，杂志用大留白放慢速度，信笺让段落像一次自然的交谈。</p><p style=\"margin: 0; font-size: 16px; line-height: 1.7; color: #4a4a4a\"><img src=\"https://images.unsplash.com/photo-1481627834876-b7833e8f5570?auto=format&amp;fit=crop&amp;w=1200&amp;q=85\" alt=\"阅读中的书页\"/></p><p style=\"margin: 0; font-size: 16px; line-height: 1.7; color: #4a4a4a\">一个完整的句子，不应该为了装饰被删掉。一张原有的表格，也不应该被换成没有事实来源的数字。</p><p style=\"margin: 0; font-size: 16px; line-height: 1.7; color: #4a4a4a\">读完之后，留下一个清楚的观点，比留下许多重复的色块更有价值。</p></section></section>",
  "layoutPrompt": "[cw-imported-style:{\"root\":\"padding:24px;color:#292b2e;background-color:#fff\",\"elements\":{\"h1\":\"margin: 0; font-size: 28px; font-weight: 800; letter-spacing: 1px; line-height: 1.3\",\"h2\":\"margin: 0; font-size: 20px; font-weight: 700; color: #1a6fc4\",\"h3\":\"margin: 0 0 10px; font-size: 17px; font-weight: 600; color: #333\",\"p\":\"margin: 0; font-size: 16px; line-height: 1.7; color: #4a4a4a\",\"ul\":\"margin: 0; padding: 0 0 0 20px; list-style-type: circle\",\"li\":\"margin-bottom: 8px; font-size: 15px; color: #4a4a4a\",\"span\":\"font-size: 14px\"}}]",
