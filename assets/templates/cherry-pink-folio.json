ax-width: 100%; width: 100%\"},\"list\":{\"frame\":\"<section>{{content}}</section>\"},\"note\":{\"frame\":\"<section>{{content}}</section>\"},\"quote\":{\"frame\":\"<section style=\\\"padding:15px 20px 5px\\\">{{content}}</section>\",\"style\":\"border: 0; border-left: 0; margin: 0; padding: 0\",\"textStyle\":\"box-sizing: border-box; color: #333; font-size: 15px; font-style: italic; line-height: 1.6; margin: 0\"},\"rule\":{\"frame\":\"<section>{{content}}</section>\"},\"table\":{\"frame\":\"<section>{{content}}</section>\"}}}}]",
